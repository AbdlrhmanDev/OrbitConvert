<Application x:Class="OrbitConvert.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown"
             ThemeMode="System">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Replaced at runtime by ThemeManager with Light.xaml or Dark.xaml. -->
                <ResourceDictionary Source="pack://application:,,,/OrbitConvert;component/Themes/Light.xaml" />
                <ResourceDictionary Source="pack://application:,,,/OrbitConvert;component/Themes/Styles.xaml" />
                <ResourceDictionary Source="pack://application:,,,/OrbitConvert;component/Localization/Strings.en.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
