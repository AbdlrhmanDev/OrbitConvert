<Window x:Class="OrbitConvert.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:OrbitConvert.App.ViewModels"
        xmlns:v="clr-namespace:OrbitConvert.App.Views"
        Title="OrbitConvert" Width="1180" Height="780" MinWidth="880" MinHeight="600"
        WindowStartupLocation="CenterScreen" Icon="/OrbitConvert;component/Assets/logo.png"
        Background="{DynamicResource Brush.Background}"
        FontFamily="{StaticResource UiFont}" AllowDrop="True">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:HomeViewModel}"><v:HomeView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ConvertViewModel}"><v:ConvertView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ToolsViewModel}"><v:ToolsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:HistoryViewModel}"><v:HistoryView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><v:SettingsView /></DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Background="{DynamicResource Brush.Sidebar}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,0">
            <DockPanel Margin="14,18,14,14">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,0,0,26">
                    <Image Source="/OrbitConvert;component/Assets/logo.png" Width="30" Height="30" RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="OrbitConvert" FontFamily="{StaticResource DisplayFont}" FontSize="17" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Text}" />
                        <TextBlock Text="Private, local file conversion" Style="{StaticResource Text.Caption}" FontSize="11" />
                    </StackPanel>
                </StackPanel>

                <!-- Queue status, bottom of sidebar -->
                <Border DockPanel.Dock="Bottom" CornerRadius="8" Padding="12,10" Background="{DynamicResource Brush.Surface}"
                        BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" Cursor="Hand"
                        MouseLeftButtonUp="OnQueueStatusClick" AutomationProperties.Name="Conversion queue status">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE895;" Style="{StaticResource Glyph}" FontSize="14" Margin="0,0,10,0"
                                   Foreground="{DynamicResource Brush.Accent}"
                                   Visibility="{Binding HasActiveJobs, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="&#xE73E;" Style="{StaticResource Glyph}" FontSize="14" Margin="0,0,10,0"
                                   Visibility="{Binding HasActiveJobs, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                        <TextBlock Text="{Binding QueueSummary}" Style="{StaticResource Text.Secondary}" FontSize="12" />
                    </StackPanel>
                </Border>

                <StackPanel>
                    <RadioButton Style="{StaticResource NavItem}" Content="Home" Tag="&#xE80F;" GroupName="Nav"
                                 IsChecked="{Binding SelectedPage, Converter={StaticResource EnumEquals}, ConverterParameter=Home}" />
                    <RadioButton Style="{StaticResource NavItem}" Content="Convert" Tag="&#xE8AB;" GroupName="Nav"
                                 IsChecked="{Binding SelectedPage, Converter={StaticResource EnumEquals}, ConverterParameter=Convert}" />
                    <RadioButton Style="{StaticResource NavItem}" Content="PDF &amp; archive tools" Tag="&#xE90F;" GroupName="Nav"
                                 IsChecked="{Binding SelectedPage, Converter={StaticResource EnumEquals}, ConverterParameter=Tools}" />
                    <RadioButton Style="{StaticResource NavItem}" Content="History" Tag="&#xE81C;" GroupName="Nav"
                                 IsChecked="{Binding SelectedPage, Converter={StaticResource EnumEquals}, ConverterParameter=History}" />
                    <RadioButton Style="{StaticResource NavItem}" Content="Settings" Tag="&#xE713;" GroupName="Nav"
                                 IsChecked="{Binding SelectedPage, Converter={StaticResource EnumEquals}, ConverterParameter=Settings}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Page content -->
        <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" Focusable="False" />

        <!-- Drop overlay: dropping anywhere in the window stages files on the Convert page -->
        <Border x:Name="DropOverlay" Grid.ColumnSpan="2" Visibility="Collapsed" IsHitTestVisible="False"
                Background="{DynamicResource Brush.DropHighlight}" Opacity="0.92">
            <Border BorderBrush="{DynamicResource Brush.Accent}" BorderThickness="3" CornerRadius="16" Margin="24">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="&#xE896;" Style="{StaticResource Glyph}" FontSize="44" Foreground="{DynamicResource Brush.Accent}" />
                    <TextBlock Text="Drop files to convert" Style="{StaticResource Text.Title}" Margin="0,14,0,0" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
