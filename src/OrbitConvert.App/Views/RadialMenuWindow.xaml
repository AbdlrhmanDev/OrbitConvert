<Window x:Class="OrbitConvert.App.Views.RadialMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:OrbitConvert.App.Controls"
        xmlns:vm="clr-namespace:OrbitConvert.App.ViewModels"
        Title="OrbitConvert — choose a format"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        Topmost="True" ShowInTaskbar="False" ShowActivated="True" SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual" Opacity="0"
        AutomationProperties.Name="OrbitConvert conversion menu">
    <Window.Resources>
        <Style x:Key="RadialItemButton" TargetType="Button">
            <Setter Property="Width" Value="{x:Static vm:RadialMenuViewModel.ItemSize}" />
            <Setter Property="Height" Value="{x:Static vm:RadialMenuViewModel.ItemSize}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1" />
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="Halo" Margin="-5" Opacity="0"
                                     Fill="{Binding Category, Converter={StaticResource CategoryToBrush}}" />
                            <Ellipse x:Name="Disc" Fill="{DynamicResource Brush.RadialItem}" StrokeThickness="2"
                                     Stroke="{Binding Category, Converter={StaticResource CategoryToBrush}}" />
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock x:Name="GlyphText" Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="18"
                                           HorizontalAlignment="Center" Margin="0,0,0,2"
                                           Foreground="{Binding Category, Converter={StaticResource CategoryToBrush}}"
                                           Visibility="{Binding Glyph, Converter={StaticResource NullToVisibility}}" />
                                <TextBlock x:Name="LabelText" Text="{Binding Label}" FontWeight="Bold" FontSize="14"
                                           HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="58"
                                           Foreground="{DynamicResource Brush.Text}" />
                            </StackPanel>
                            <Border Width="16" Height="16" CornerRadius="8" HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Background="{DynamicResource Brush.Warning}" ToolTip="Experimental"
                                    Visibility="{Binding Experimental, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="β" FontSize="10" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding Glyph, Converter={StaticResource NullToVisibility}}" Value="Visible">
                                <Setter TargetName="LabelText" Property="FontSize" Value="11" />
                                <Setter TargetName="LabelText" Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Halo" Property="Opacity" Value="0.22" />
                                <Setter TargetName="Disc" Property="StrokeThickness" Value="3" />
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.1" ScaleY="1.1" />
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Disc" Property="Opacity" Value="0.8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root" Width="{Binding Diameter}" Height="{Binding Diameter}" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="RootScale" ScaleX="0.86" ScaleY="0.86" />
        </Grid.RenderTransform>

        <!-- Translucent disc -->
        <Ellipse Margin="8" Fill="{DynamicResource Brush.RadialDisc}" Stroke="{DynamicResource Brush.RadialBorder}" StrokeThickness="1">
            <Ellipse.Effect>
                <DropShadowEffect BlurRadius="26" ShadowDepth="3" Opacity="0.35" Color="Black" />
            </Ellipse.Effect>
        </Ellipse>

        <!-- Format ring(s) -->
        <ItemsControl ItemsSource="{Binding Items}" Focusable="False" IsEnabled="{Binding IsChoosing}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="Canvas.Left" Value="{Binding X}" />
                    <Setter Property="Canvas.Top" Value="{Binding Y}" />
                </Style>
            </ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Style="{StaticResource RadialItemButton}"
                            Command="{Binding DataContext.ActivateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}"
                            ToolTip="{Binding ToolTip}" ToolTipService.InitialShowDelay="700"
                            AutomationProperties.Name="{Binding AccessibleName}"
                            AutomationProperties.HelpText="{Binding Description}"
                            MouseEnter="OnItemMouseEnter" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Center -->
        <Border Width="{Binding CenterSize}" Height="{Binding CenterSize}" CornerRadius="999"
                Background="{DynamicResource Brush.RadialCenter}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid>
                <!-- Choosing: what is being converted -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="14,0"
                            Visibility="{Binding ShowCenterInfo, Converter={StaticResource BoolToVisibility}}">
                    <c:FormatBadge Width="30" Height="36" Label="{Binding CenterLabel}" Category="{Binding CenterCategory}" Margin="0,0,0,6" />
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" TextAlignment="Center" TextWrapping="Wrap"
                               MaxHeight="36" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Brush.Text}" />
                    <TextBlock Text="{Binding Subtitle}" FontSize="11" TextAlignment="Center" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource Brush.TextTertiary}" />
                    <TextBlock Text="{Binding StatusText}" FontSize="11" TextAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,0"
                               Foreground="{DynamicResource Brush.Warning}"
                               Visibility="{Binding StatusText, Converter={StaticResource NullToVisibility}}" />
                </StackPanel>

                <!-- Working -->
                <Grid Visibility="{Binding IsWorking, Converter={StaticResource BoolToVisibility}}">
                    <c:ProgressRing Margin="8" Thickness="5" Value="{Binding Progress}" Foreground="{DynamicResource Brush.Accent}" />
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16,0">
                        <TextBlock x:Name="PercentText" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource Brush.Text}" />
                        <TextBlock Text="{Binding StatusText}" FontSize="11" TextAlignment="Center" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Brush.TextSecondary}" />
                    </StackPanel>
                </Grid>

                <!-- Succeeded -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="14,0"
                            Visibility="{Binding IsSucceeded, Converter={StaticResource BoolToVisibility}}">
                    <Border Width="44" Height="44" CornerRadius="22" Background="{DynamicResource Brush.Success}" Margin="0,0,0,6">
                        <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="20" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{Binding StatusText}" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" MaxHeight="34"
                               TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Brush.Text}" />
                    <Button Content="Show in folder" Style="{StaticResource SubtleButton}" FontSize="12" Padding="8,3" Margin="0,4,0,0"
                            Command="{Binding RevealOutputCommand}" Focusable="True" />
                </StackPanel>

                <!-- Failed -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16,0"
                            Visibility="{Binding IsFailed, Converter={StaticResource BoolToVisibility}}">
                    <Border Width="40" Height="40" CornerRadius="20" Background="{DynamicResource Brush.Danger}" Margin="0,0,0,4">
                        <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="16" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{Binding ErrorText}" FontSize="11" TextAlignment="Center" TextWrapping="Wrap" MaxHeight="58"
                               TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Brush.Text}" ToolTip="{Binding ErrorText}" />
                    <Button Content="Details" Style="{StaticResource SubtleButton}" FontSize="12" Padding="8,3" Margin="0,2,0,0"
                            Command="{Binding ShowDetailsCommand}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
