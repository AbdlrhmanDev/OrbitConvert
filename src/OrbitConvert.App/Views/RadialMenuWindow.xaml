<Window x:Class="OrbitConvert.App.Views.RadialMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:OrbitConvert.App.Controls"
        xmlns:vm="clr-namespace:OrbitConvert.App.ViewModels"
        Title="OrbitConvert — choose a format"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize" AllowDrop="True"
        Topmost="True" ShowInTaskbar="False" ShowActivated="True"
        Width="{x:Static vm:RadialMenuViewModel.WindowSize}" Height="{x:Static vm:RadialMenuViewModel.WindowSize}"
        WindowStartupLocation="Manual" Opacity="0" FontFamily="{StaticResource UiFont}"
        AutomationProperties.Name="OrbitConvert Orbit Menu">
    <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="RootScale" ScaleX="0.92" ScaleY="0.92" />
        </Grid.RenderTransform>

        <!-- The wheel: halo, segments, core and progress ring (380 DIPs = 0.95 × the 400-unit grid). -->
        <c:RadialWheel x:Name="Wheel" Width="380" Height="380"
                       ItemsSource="{Binding Items}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                       IsHovering="{Binding IsHovering, Mode=TwoWay}" Progress="{Binding Progress}"
                       ItemCommand="{Binding ActivateCommand}" IsEnabled="{Binding IsChoosing}">
            <c:RadialWheel.Effect>
                <DropShadowEffect BlurRadius="40" ShadowDepth="16" Direction="270" Opacity="0.55" Color="Black" />
            </c:RadialWheel.Effect>
        </c:RadialWheel>

        <!-- Accessible list of the drawn segments for screen readers and UI Automation. -->
        <ItemsControl ItemsSource="{Binding Items}" Opacity="0" Focusable="False" HorizontalAlignment="Left" VerticalAlignment="Top"
                      AutomationProperties.Name="Choices">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button AutomationProperties.Name="{Binding AccessibleName}" AutomationProperties.HelpText="{Binding ToolTip}"
                            Command="{Binding DataContext.ActivateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}" Width="1" Height="1" MinHeight="0" Padding="0" Focusable="False" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Core: always says what will happen. -->
        <StackPanel Width="124" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
            <TextBlock Text="{Binding CoreTop}" FontFamily="{StaticResource MonoFont}" FontSize="9.5" Foreground="{DynamicResource Brush.RadialAccentText}"
                       HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="118" />
            <TextBlock Text="{Binding CoreMain}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Brush.RadialItemText}"
                       HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="124" Margin="0,3,0,3" />
            <TextBlock Text="{Binding CoreSub}" FontFamily="{StaticResource MonoFont}" FontSize="10" Foreground="{DynamicResource Brush.RadialItemHint}"
                       HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="118" />
        </StackPanel>

        <!-- Failure detail sits over the lower ring; segments are inactive in this state. -->
        <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,66" MaxWidth="290" Padding="12,8" CornerRadius="10"
                Background="{DynamicResource Brush.RadialCenter}" BorderBrush="#FF6B5E" BorderThickness="1"
                Visibility="{Binding IsFailed, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Text="{Binding ErrorText}" FontSize="12" TextWrapping="Wrap" MaxHeight="48" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource Brush.RadialItemText}" ToolTip="{Binding ErrorText}" />
                <Button Content="Details" Style="{StaticResource SubtleButton}" FontSize="12" Padding="8,3" Margin="0,4,0,0"
                        Foreground="{DynamicResource Brush.RadialAccentText}" HorizontalAlignment="Left" Command="{Binding ShowDetailsCommand}" />
            </StackPanel>
        </Border>

        <!-- Keyboard legend, as in the identity sheet. -->
        <TextBlock VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,6" FontFamily="{StaticResource MonoFont}" FontSize="10"
                   Foreground="{DynamicResource Brush.RadialItemHint}" Text="← → move   Enter choose   Esc dismiss"
                   Visibility="{Binding IsChoosing, Converter={StaticResource BoolToVisibility}}" />
    </Grid>
</Window>
