<UserControl x:Class="OrbitConvert.App.Views.AutomationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="Pill" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.SurfaceAlt}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32">
            <DockPanel Margin="0,0,0,20">
                <Button DockPanel.Dock="Right" Content="{DynamicResource NewWatcher}" Style="{StaticResource PrimaryButton}" FontSize="13" Padding="14,9"
                        VerticalAlignment="Bottom" Command="{Binding NewWatcherCommand}" />
                <StackPanel>
                    <TextBlock Text="{DynamicResource Automation}" Style="{StaticResource Text.Display}" />
                    <TextBlock Text="{DynamicResource AutomationIntro}"
                               Style="{StaticResource Text.Secondary}" FontSize="14" Foreground="{DynamicResource Brush.TextTertiary}" Margin="0,4,0,0" />
                </StackPanel>
            </DockPanel>

            <TextBlock Text="{Binding Message, Converter={StaticResource LocalizedString}}" Style="{StaticResource Text.Secondary}" Margin="0,0,0,12"
                       Visibility="{Binding Message, Converter={StaticResource NullToVisibility}}" />

            <!-- New watcher form -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12" Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource NewWatcher}" Style="{StaticResource Text.Subtitle}" />
                    <TextBlock Text="{DynamicResource FolderToWatch}" Style="{StaticResource Text.Caption}" Margin="0,12,0,4" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="{DynamicResource Browse}" Style="{StaticResource OutlineButton}" Margin="8,0,0,0" Command="{Binding BrowseNewPathCommand}" />
                        <TextBox Text="{Binding NewPath, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}" AutomationProperties.Name="{DynamicResource FolderToWatch}" />
                    </DockPanel>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource WatcherExtensions}" Style="{StaticResource Text.Caption}" Margin="0,0,0,4" TextTrimming="CharacterEllipsis" />
                            <TextBox Text="{Binding NewExtensions, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}"
                                     AutomationProperties.Name="{DynamicResource ExtensionsExample}" ToolTip="{DynamicResource ExampleExtensions}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{DynamicResource RunPreset}" Style="{StaticResource Text.Caption}" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding NewPreset}" DisplayMemberPath="Name" AutomationProperties.Name="{DynamicResource PresetToRun}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{DynamicResource SaveTo}" Style="{StaticResource Text.Caption}" Margin="0,12,0,4" />
                    <RadioButton Content="{DynamicResource BesideOriginal}" IsChecked="{Binding NewBesideOriginal}" GroupName="WatchOut" Margin="0,0,0,6" />
                    <DockPanel>
                        <RadioButton Content="{DynamicResource FolderColon}" GroupName="WatchOut" VerticalAlignment="Center" Margin="0,0,8,0"
                                     IsChecked="{Binding NewBesideOriginal, Converter={StaticResource InverseBool}}" />
                        <Button DockPanel.Dock="Right" Content="{DynamicResource Browse}" Style="{StaticResource OutlineButton}" Margin="8,0,0,0" Command="{Binding BrowseNewOutputCommand}" />
                        <TextBox Text="{Binding NewOutputFolder, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}"
                                 IsEnabled="{Binding NewBesideOriginal, Converter={StaticResource InverseBool}}" AutomationProperties.Name="{DynamicResource OutputFolder}" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,12,0,0"
                               Text="{DynamicResource WatcherSafety}" />
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Content="{DynamicResource AddWatcher}" Style="{StaticResource PrimaryButton}" FontSize="13" Padding="14,8" Command="{Binding SaveNewCommand}" />
                        <Button Content="{DynamicResource Cancel}" Style="{StaticResource OutlineButton}" Margin="8,0,0,0" Command="{Binding CancelNewCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{DynamicResource NoWatchers}"
                           Style="{StaticResource Text.Secondary}" />
            </Border>

            <ItemsControl ItemsSource="{Binding Watchers}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,12" Padding="18" CornerRadius="14" Background="{DynamicResource Brush.Surface}"
                                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                    <Button Content="&#xE74D;" Style="{StaticResource IconButton}" ToolTip="{DynamicResource DeleteWatcher}" Command="{Binding DeleteCommand}" Margin="0,0,12,0" />
                                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Enabled}" AutomationProperties.Name="{Binding Path, StringFormat='Watch {0}'}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="{Binding Path, Converter={StaticResource LocalizedString}}" FontFamily="{StaticResource MonoFont}" FontSize="14" Foreground="{DynamicResource Brush.Text}"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Path, Converter={StaticResource LocalizedString}}" />
                                    <WrapPanel Margin="0,8,0,0">
                                        <Border Style="{StaticResource Pill}"><TextBlock FontSize="12" Foreground="{DynamicResource Brush.Text}"><Run Text="{DynamicResource WhenPrefix}" /><Run Text="{Binding When, Mode=OneWay, Converter={StaticResource LocalizedString}}" /></TextBlock></Border>
                                        <Border Style="{StaticResource Pill}"><TextBlock FontSize="12" Foreground="{DynamicResource Brush.Text}"><Run Text="{DynamicResource DoPrefix}" /><Run Text="{Binding Do, Mode=OneWay, Converter={StaticResource LocalizedString}}" /></TextBlock></Border>
                                        <Border Style="{StaticResource Pill}"><TextBlock FontSize="12" Foreground="{DynamicResource Brush.Text}"><Run Text="{DynamicResource SaveToColon}" /><Run Text="{Binding SaveTo, Mode=OneWay, Converter={StaticResource LocalizedString}}" /></TextBlock></Border>
                                    </WrapPanel>
                                    <TextBlock Text="{Binding Status, Converter={StaticResource LocalizedString}}" Margin="0,8,0,0" TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasProblem}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
