<UserControl x:Class="OrbitConvert.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="40,32,40,24">
        <StackPanel DockPanel.Dock="Top">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource SubtleButton}" Command="{Binding ClearCommand}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74D;" Style="{StaticResource Glyph}" FontSize="13" Margin="0,0,6,0" Foreground="{DynamicResource Brush.Text}" />
                        <TextBlock Text="Clear history" />
                    </StackPanel>
                </Button>
                <TextBlock Text="History" Style="{StaticResource Text.Display}" />
            </DockPanel>
            <TextBlock Text="Stored only on this computer. Turn history off in Settings → Privacy." Style="{StaticResource Text.Secondary}" Margin="0,4,0,16" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <RadioButton Content="All" GroupName="HistoryFilter" Margin="0,0,16,0"
                             IsChecked="{Binding Filter, Converter={StaticResource EnumEquals}, ConverterParameter=All}" />
                <RadioButton Content="Successful" GroupName="HistoryFilter" Margin="0,0,16,0"
                             IsChecked="{Binding Filter, Converter={StaticResource EnumEquals}, ConverterParameter=Succeeded}" />
                <RadioButton Content="Failed" GroupName="HistoryFilter"
                             IsChecked="{Binding Filter, Converter={StaticResource EnumEquals}, ConverterParameter=Failed}" />
            </StackPanel>
            <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Secondary}" Margin="0,0,0,10"
                       Visibility="{Binding Message, Converter={StaticResource NullToVisibility}}" />
            <TextBlock Text="History is turned off, so new conversions are not recorded." Style="{StaticResource Text.Secondary}"
                       Foreground="{DynamicResource Brush.Warning}" Margin="0,0,0,10"
                       Visibility="{Binding HistoryDisabled, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>

        <Border Style="{StaticResource Card}" Padding="6">
            <Grid>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="&#xE81C;" Style="{StaticResource Glyph}" FontSize="30" />
                    <TextBlock Text="No conversions to show" Style="{StaticResource Text.Subtitle}" HorizontalAlignment="Center" Margin="0,10,0,0" />
                </StackPanel>
                <ListBox ItemsSource="{Binding Entries}" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}"
                         AutomationProperties.Name="Conversion history">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="AutomationProperties.Name" Value="{Binding InputSummary}" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="4,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="Glyph" Text="&#xE73E;" Style="{StaticResource Glyph}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,3,0,0"
                                           Foreground="{DynamicResource Brush.Success}" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Style="{StaticResource Text.Body}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding InputSummary, Mode=OneWay}" /><Run Text="  →  " Foreground="{DynamicResource Brush.TextTertiary}" /><Run Text="{Binding TargetLabel, Mode=OneWay}" FontWeight="SemiBold" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding Note}" Style="{StaticResource Text.Caption}" Visibility="{Binding Note, Converter={StaticResource NullToVisibility}}" />
                                    <TextBlock x:Name="Error" Text="{Binding Error}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Danger}"
                                               TextWrapping="Wrap" Visibility="Collapsed" />
                                    <TextBlock Text="{Binding Outputs[0]}" Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Outputs[0]}" Visibility="{Binding Outputs, Converter={StaticResource NullToVisibility}}" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding Timestamp, Converter={StaticResource RelativeTime}}" Style="{StaticResource Text.Caption}"
                                           VerticalAlignment="Top" Margin="12,3,8,0" />
                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Top">
                                    <Button Content="&#xE8B7;" Style="{StaticResource IconButton}" ToolTip="Show in folder"
                                            Command="{Binding DataContext.RevealCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    <Button Content="&#xE72C;" Style="{StaticResource IconButton}" ToolTip="Convert again"
                                            Command="{Binding DataContext.RetryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    <Button Content="&#xE74D;" Style="{StaticResource IconButton}" ToolTip="Remove from history"
                                            Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                </StackPanel>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Succeeded}" Value="False">
                                    <Setter TargetName="Glyph" Property="Text" Value="&#xE783;" />
                                    <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                                    <Setter TargetName="Error" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </DockPanel>
</UserControl>
