<UserControl x:Class="OrbitConvert.App.Views.PresetsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32">
            <TextBlock Text="Presets" Style="{StaticResource Text.Display}" />
            <TextBlock Text="Starred presets appear in the Orbit Menu. Save your own from the Convert page."
                       Style="{StaticResource Text.Secondary}" FontSize="14" Foreground="{DynamicResource Brush.TextTertiary}" Margin="0,4,0,20" />
            <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Secondary}" Margin="0,0,0,12"
                       Visibility="{Binding Message, Converter={StaticResource NullToVisibility}}" />

            <ItemsControl ItemsSource="{Binding Cards}" Focusable="False">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,12,12" Padding="18" CornerRadius="14" Background="{DynamicResource Brush.Surface}"
                                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top">
                                    <ToggleButton DockPanel.Dock="Right" IsChecked="{Binding Starred, Mode=OneWay}" Command="{Binding ToggleStarCommand}"
                                                  ToolTip="{Binding StarToolTip}" AutomationProperties.Name="{Binding Name, StringFormat='Star {0}'}"
                                                  Cursor="Hand" FocusVisualStyle="{x:Null}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <TextBlock x:Name="Star" Text="★" FontSize="18" Foreground="{DynamicResource Brush.BorderStrong}" Background="Transparent" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="Star" Property="Foreground" Value="{DynamicResource Brush.AccentText}" />
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Star" Property="Opacity" Value="0.8" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                    <TextBlock Text="{Binding Tag}" Style="{StaticResource Text.Mono}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"
                                               Foreground="{Binding Category, Converter={StaticResource CategoryToBrush}}" />
                                </DockPanel>
                                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,14,0,0">
                                    <Button Content="Run…" Style="{StaticResource SmallOutlineButton}" Command="{Binding RunCommand}"
                                            ToolTip="Choose files and run this preset" />
                                    <Button Content="Delete" Style="{StaticResource SmallOutlineButton}" Margin="6,0,0,0" Command="{Binding DeleteCommand}"
                                            Foreground="{DynamicResource Brush.TextTertiary}"
                                            Visibility="{Binding CanDelete, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" Margin="0,10,0,0" Foreground="{DynamicResource Brush.Text}" />
                                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Mono}" LineHeight="19" Margin="0,10,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
