<Window x:Class="OrbitConvert.App.Views.ImageEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource ImageEditor}" Width="1080" Height="720" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource Brush.Window}">
    <Grid Margin="24">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="340"/></Grid.ColumnDefinitions>
        <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="16" Padding="16" Margin="0,0,18,0">
            <Grid>
                <Image Source="{Binding Preview}" Stretch="Uniform" AutomationProperties.Name="{DynamicResource EditedPreview}"/>
                <TextBlock Text="{DynamicResource RenderingPreview}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"/>
            </Grid>
        </Border>
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="{DynamicResource ImageEditor}" Style="{StaticResource Text.Title}"/>
                <TextBlock Text="{Binding FileName, Converter={StaticResource LocalizedString}}" Style="{StaticResource Text.Secondary}" Margin="0,4,0,18"/>
                <TextBlock Text="{DynamicResource Size}" Style="{StaticResource Text.Caption}"/>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,14">
                    <TextBox Text="{Binding Width}" Width="100" AutomationProperties.Name="{DynamicResource Width}"/><TextBlock Text="×" Margin="8,5"/>
                    <TextBox Text="{Binding Height}" Width="100" AutomationProperties.Name="{DynamicResource Height}"/>
                </StackPanel>
                <TextBlock Text="{DynamicResource RotateFlip}" Style="{StaticResource Text.Caption}"/>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,14">
                    <ComboBox ItemsSource="{Binding Rotations}" SelectedItem="{Binding RotationDegrees}" Width="110"/>
                    <ComboBox ItemsSource="{Binding Flips}" SelectedItem="{Binding Flip}" Width="140" Margin="8,0,0,0"/>
                </StackPanel>
                <TextBlock Text="{DynamicResource Brightness}" Style="{StaticResource Text.Caption}"/>
                <Slider Minimum="-100" Maximum="100" Value="{Binding Brightness}" TickFrequency="5"/>
                <TextBlock Text="{DynamicResource Contrast}" Style="{StaticResource Text.Caption}" Margin="0,10,0,0"/>
                <Slider Minimum="-100" Maximum="100" Value="{Binding Contrast}" TickFrequency="5"/>
                <Button Content="{DynamicResource RefreshPreview}" Command="{Binding RefreshPreviewCommand}" Style="{StaticResource OutlineButton}" Margin="0,12,0,18"/>

                <TextBlock Text="{DynamicResource Annotation}" Style="{StaticResource Text.Caption}"/>
                <TextBox Text="{Binding AnnotationText}" Margin="0,6,0,6"/>
                <StackPanel Orientation="Horizontal"><TextBox Text="{Binding AnnotationColor}" Width="120"/><Button Content="{DynamicResource AddText}" Command="{Binding AddTextCommand}" Margin="8,0,0,0"/></StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <ComboBox ItemsSource="{Binding AnnotationKinds}" SelectedItem="{Binding AnnotationKind}" Width="150" AutomationProperties.Name="{DynamicResource AnnotationShape}"/>
                    <Button Content="{DynamicResource AddShape}" Command="{Binding AddShapeCommand}" Margin="8,0,0,0"/>
                </StackPanel>

                <TextBlock Text="{DynamicResource RedactionArea}" Style="{StaticResource Text.Caption}" Margin="0,18,0,6"/>
                <UniformGrid Columns="4"><TextBox Text="{Binding RedactX}" ToolTip="X"/><TextBox Text="{Binding RedactY}" ToolTip="Y"/><TextBox Text="{Binding RedactWidth}" ToolTip="{DynamicResource Width}"/><TextBox Text="{Binding RedactHeight}" ToolTip="{DynamicResource Height}"/></UniformGrid>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0"><Button Content="{DynamicResource AddRedaction}" Command="{Binding AddRedactionCommand}"/><Button Content="{DynamicResource ClearOverlays}" Command="{Binding ClearOverlaysCommand}" Margin="8,0,0,0"/></StackPanel>

                <TextBlock Text="{DynamicResource Metadata}" Style="{StaticResource Text.Caption}" Margin="0,18,0,6"/>
                <TextBlock Text="{DynamicResource GpsHint}"
                           Style="{StaticResource Text.Caption}" TextWrapping="Wrap"/>
                <ItemsControl ItemsSource="{Binding Metadata}" MaxHeight="150" Margin="0,6,0,0">
                    <ItemsControl.Template><ControlTemplate><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer></ControlTemplate></ItemsControl.Template>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected}" Margin="0,2" ToolTip="{Binding Value, Converter={StaticResource LocalizedString}}">
                                <TextBlock Text="{Binding Label, Converter={StaticResource LocalizedString}}" TextTrimming="CharacterEllipsis"/>
                            </CheckBox>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="{DynamicResource RemoveSelected}" Command="{Binding RemoveSelectedMetadataCommand}"/>
                    <Button Content="{DynamicResource RemoveAll}" Command="{Binding RemoveAllMetadataCommand}" Margin="8,0,0,0"/>
                </StackPanel>

                <TextBlock Text="{Binding ErrorText, Converter={StaticResource LocalizedString}}" Foreground="{DynamicResource Brush.Danger}" TextWrapping="Wrap" Margin="0,12,0,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                    <Button Content="{DynamicResource Cancel}" Command="{Binding CancelCommand}" Style="{StaticResource OutlineButton}" Margin="0,0,8,0"/>
                    <Button Content="{DynamicResource SaveCopy}" Command="{Binding ApplyCommand}" Style="{StaticResource PrimaryButton}"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
