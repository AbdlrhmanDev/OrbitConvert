<Window x:Class="OrbitConvert.App.Views.BackgroundEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add background — OrbitConvert" Width="880" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True" FontFamily="{StaticResource UiFont}"
        AutomationProperties.Name="Add background editor">
    <Window.Resources>
        <Style x:Key="Chip" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="7" BorderThickness="1" Padding="0,7" Background="Transparent" BorderBrush="{DynamicResource Brush.Track}">
                            <ContentPresenter HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.AccentText}" />
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.AccentSubtle}" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.AccentText}" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.AccentText}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SwatchButton" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="Ring" Margin="-4" Stroke="{DynamicResource Brush.Text}" StrokeThickness="2" Visibility="Hidden" />
                            <Ellipse Fill="{TemplateBinding Background}" Stroke="{DynamicResource Brush.Track}" StrokeThickness="1" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DrawingBrush x:Key="Checkerboard" TileMode="Tile" Viewport="0,0,20,20" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#0E1014" Geometry="M0,0 H2 V2 H0 Z" />
                    <GeometryDrawing Brush="#14161B" Geometry="M0,0 H1 V1 H0 Z M1,1 H2 V2 H1 Z" />
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </Window.Resources>

    <Border Margin="20" CornerRadius="14" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Track}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="16" Direction="270" Opacity="0.55" Color="Black" />
        </Border.Effect>
        <DockPanel>
            <Border DockPanel.Dock="Top" Height="44" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1"
                    Background="Transparent" MouseLeftButtonDown="OnHeaderMouseDown" Cursor="SizeAll">
                <DockPanel Margin="16,0,8,0">
                    <Button DockPanel.Dock="Right" Content="✕" Style="{StaticResource IconButton}" FontFamily="{StaticResource UiFont}"
                            ToolTip="Close" Command="{Binding CancelCommand}" Cursor="Hand" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ContentControl Style="{StaticResource StrokeIcon}" Width="16" Height="16" Foreground="{DynamicResource Brush.AccentText}"
                                        Tag="M3 3h18v18H3zM7 7h10v10H7z" />
                        <TextBlock Text="Add background" FontSize="14" FontWeight="SemiBold" Margin="10,0,10,0" Foreground="{DynamicResource Brush.Text}" />
                        <TextBlock Text="{Binding FileName}" Style="{StaticResource Text.Mono}" VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="470" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Live preview on a transparency checkerboard -->
                <Border Height="530" Background="{StaticResource Checkerboard}" CornerRadius="0,0,0,13">
                    <Border Width="{Binding PreviewCanvasWidth}" Height="{Binding PreviewCanvasHeight}" Background="{Binding PreviewBrush}"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Width="{Binding PreviewImageWidth}" Height="{Binding PreviewImageHeight}" CornerRadius="{Binding PreviewCorner}"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding InputPath}" Stretch="Fill" />
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="{Binding PreviewShadowBlur}" ShadowDepth="{Binding PreviewShadowDepth}"
                                                  Direction="270" Opacity="{Binding PreviewShadowOpacity}" Color="Black" />
                            </Border.Effect>
                        </Border>
                    </Border>
                </Border>

                <DockPanel Grid.Column="1" Height="530">
                <!-- Export summary and actions stay visible below the scrolling controls. -->
                <StackPanel DockPanel.Dock="Bottom" Margin="20,0,20,20">
                        <Border Margin="0,4,0,0" Padding="12" CornerRadius="10" Background="{DynamicResource Brush.Window}"
                                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="Export" Style="{StaticResource Text.Mono}" />
                                    <TextBlock Text="{Binding ExportText}" Style="{StaticResource Text.Mono}" Foreground="{DynamicResource Brush.Text}" HorizontalAlignment="Right" />
                                </DockPanel>
                                <DockPanel Margin="0,6,0,0">
                                    <TextBlock Text="File" Style="{StaticResource Text.Mono}" />
                                    <TextBlock Text="{Binding OutputName}" Style="{StaticResource Text.Mono}" Foreground="{DynamicResource Brush.Text}"
                                               HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" Margin="12,0,0,0" />
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{Binding ErrorText}" Foreground="{DynamicResource Brush.Danger}" TextWrapping="Wrap" Margin="0,12,0,0" FontSize="12"
                                   Visibility="{Binding ErrorText, Converter={StaticResource NullToVisibility}}" />

                        <DockPanel Margin="0,16,0,0">
                            <Button Content="Reset" Command="{Binding ResetCommand}" Margin="0,0,8,0" Padding="14,9" />
                            <Button Content="Save with background" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" />
                        </DockPanel>
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20,20,20,8">
                        <TextBlock Text="Background" Style="{StaticResource Text.Caption}" Margin="0,0,0,8" />
                        <WrapPanel>
                            <ItemsControl ItemsSource="{Binding Swatches}" Focusable="False">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource SwatchButton}" Background="{Binding Preview}" ToolTip="{Binding Name}"
                                                AutomationProperties.Name="{Binding Name}"
                                                Command="{Binding DataContext.PickSwatchCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Width="30" Height="30" Margin="0,0,8,8" Cursor="Hand" ToolTip="Custom color" AutomationProperties.Name="Custom color"
                                    Command="{Binding PickCustomColorCommand}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Grid>
                                            <Ellipse Stroke="{DynamicResource Brush.BorderStrong}" StrokeDashArray="3 2" StrokeThickness="1" Fill="Transparent" />
                                            <TextBlock Text="+" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource Brush.TextTertiary}" />
                                        </Grid>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </WrapPanel>
                        <TextBlock Text="{Binding CustomColor, StringFormat=Custom {0}}" Style="{StaticResource Text.Mono}"
                                   Visibility="{Binding CustomColor, Converter={StaticResource NullToVisibility}}" />

                        <TextBlock Text="Canvas" Style="{StaticResource Text.Caption}" Margin="0,12,0,8" />
                        <ItemsControl ItemsSource="{Binding Aspects}" Focusable="False">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Label}" Style="{StaticResource Chip}" AutomationProperties.Name="{Binding Label}"
                                            Command="{Binding DataContext.PickAspectCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <DockPanel Margin="0,16,0,4">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding PaddingPercent, StringFormat={}{0}%}" Style="{StaticResource Text.Mono}" />
                            <TextBlock Text="Padding" Foreground="{DynamicResource Brush.Text}" FontSize="13" />
                        </DockPanel>
                        <Slider Minimum="0" Maximum="30" Value="{Binding PaddingPercent}" IsSnapToTickEnabled="True" TickFrequency="1" AutomationProperties.Name="Padding" />
                        <DockPanel Margin="0,12,0,4">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding CornerRadius, StringFormat={}{0} px}" Style="{StaticResource Text.Mono}" />
                            <TextBlock Text="Corner radius" Foreground="{DynamicResource Brush.Text}" FontSize="13" />
                        </DockPanel>
                        <Slider Minimum="0" Maximum="60" Value="{Binding CornerRadius}" IsSnapToTickEnabled="True" TickFrequency="1" AutomationProperties.Name="Corner radius" />
                        <DockPanel Margin="0,12,0,4">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding ShadowBlur, StringFormat={}{0} px}" Style="{StaticResource Text.Mono}" />
                            <TextBlock Text="Shadow blur" Foreground="{DynamicResource Brush.Text}" FontSize="13" />
                        </DockPanel>
                        <Slider Minimum="0" Maximum="100" Value="{Binding ShadowBlur}" IsSnapToTickEnabled="True" TickFrequency="1" AutomationProperties.Name="Shadow blur" />
                        <DockPanel Margin="0,12,0,4">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding ShadowOpacity, StringFormat={}{0}%}" Style="{StaticResource Text.Mono}" />
                            <TextBlock Text="Shadow opacity" Foreground="{DynamicResource Brush.Text}" FontSize="13" />
                        </DockPanel>
                        <Slider Minimum="0" Maximum="90" Value="{Binding ShadowOpacity}" IsSnapToTickEnabled="True" TickFrequency="1" AutomationProperties.Name="Shadow opacity" />

                    </StackPanel>
                </ScrollViewer>
                </DockPanel>
            </Grid>
        </DockPanel>
    </Border>
</Window>
