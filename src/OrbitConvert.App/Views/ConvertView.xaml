<UserControl x:Class="OrbitConvert.App.Views.ConvertView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:c="clr-namespace:OrbitConvert.App.Controls">
    <UserControl.Resources>
        <Style x:Key="OptionLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Secondary}">
            <Setter Property="Margin" Value="0,10,0,4" />
        </Style>
        <Style x:Key="OptionGroup" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="FactLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}" />
        <Style x:Key="FactValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        </Style>
        <!-- Output format tiles: mono label + hint; lime border when selected; faded when unavailable. -->
        <Style x:Key="FormatTiles" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <WrapPanel ItemWidth="124" />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Margin" Value="0,0,8,8" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="ToolTip" Value="{Binding ToolTip}" />
                        <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
                        <Setter Property="AutomationProperties.HelpText" Value="{Binding Hint}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}"
                                            BorderThickness="1.5" CornerRadius="10" Padding="12">
                                        <StackPanel>
                                            <TextBlock x:Name="Label" Text="{Binding Label, Converter={StaticResource LocalizedString}}" FontFamily="{StaticResource MonoFont}" FontSize="14" FontWeight="Bold"
                                                       Foreground="{DynamicResource Brush.Text}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Hint, Converter={StaticResource LocalizedString}}" FontSize="11" Margin="0,4,0,0" Foreground="{DynamicResource Brush.TextTertiary}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.AccentSubtle}" />
                                            <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Brush.AccentText}" />
                                        </Trigger>
                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.AccentText}" />
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                            <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                                            <Setter Property="Cursor" Value="No" />
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="32,32,24,24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="420" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="360" />
        </Grid.ColumnDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
            <StackPanel>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="{DynamicResource AddFiles}" Style="{StaticResource OutlineButton}" Command="{Binding AddFilesCommand}" />
                        <Button Content="{DynamicResource Clear}" Style="{StaticResource OutlineButton}" Margin="8,0,0,0" Command="{Binding ClearFilesCommand}"
                                Visibility="{Binding HasFiles, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                    <TextBlock Text="{DynamicResource Convert}" Style="{StaticResource Text.Display}" />
                </DockPanel>

                <!-- Empty state -->
                <Border CornerRadius="14" Padding="28" Margin="0,20,0,0" Background="{DynamicResource Brush.Surface}"
                        BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                        Visibility="{Binding HasFiles, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{DynamicResource NoFiles}" Style="{StaticResource Text.Subtitle}" HorizontalAlignment="Center" />
                        <TextBlock Text="{DynamicResource DropAnywhere}" Style="{StaticResource Text.Secondary}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- Preview card -->
                <Border CornerRadius="14" Padding="16" Margin="0,20,0,0" Background="{DynamicResource Brush.Surface}"
                        BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" DataContext="{Binding PreviewFile}"
                        Visibility="{Binding Converter={StaticResource NullToVisibility}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="88" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="88" Height="88" CornerRadius="10" Background="{DynamicResource Brush.SurfaceAlt}" BorderBrush="{DynamicResource Brush.Border}"
                                BorderThickness="1" VerticalAlignment="Top" ClipToBounds="True">
                            <Grid>
                                <TextBlock Text="{Binding TypeLabel, Converter={StaticResource LocalizedString}}" Style="{StaticResource Text.Mono}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{Binding Category, Converter={StaticResource CategoryToBrush}}" />
                                <Image Source="{Binding Preview}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="16,0,0,0">
                            <TextBlock Text="{Binding Name, Converter={StaticResource LocalizedString}}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Input.Path, Converter={StaticResource LocalizedString}}" />
                            <UniformGrid Columns="4" Margin="0,10,0,0">
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="{DynamicResource Type}" Style="{StaticResource FactLabel}" />
                                    <TextBlock Text="{Binding TypeName, Converter={StaticResource LocalizedString}}" Style="{StaticResource FactValue}" ToolTip="{Binding TypeName, Converter={StaticResource LocalizedString}}"
                                               Foreground="{Binding Category, Converter={StaticResource CategoryToBrush}}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="{DynamicResource Size}" Style="{StaticResource FactLabel}" />
                                    <TextBlock Text="{Binding SizeText, Converter={StaticResource LocalizedString}}" Style="{StaticResource FactValue}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="{DynamicResource Dimensions}" Style="{StaticResource FactLabel}" />
                                    <TextBlock Text="{Binding Dimensions, Converter={StaticResource LocalizedString}}" Style="{StaticResource FactValue}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Signature}" Style="{StaticResource FactLabel}" />
                                    <TextBlock Text="{Binding SignatureText, Converter={StaticResource LocalizedString}}" Style="{StaticResource FactValue}"
                                               ToolTip="{DynamicResource SignatureHint}" />
                                </StackPanel>
                            </UniformGrid>
                            <TextBlock Text="{Binding Warning, Converter={StaticResource LocalizedString}}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Warning}" TextWrapping="Wrap"
                                       Margin="0,8,0,0" Visibility="{Binding Warning, Converter={StaticResource NullToVisibility}}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Several files: compact list; selecting one previews it -->
                <Border Style="{StaticResource Card}" Padding="8" Margin="0,12,0,0" Visibility="{Binding HasSeveralFiles, Converter={StaticResource BoolToVisibility}}">
                    <ListBox ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile}" MaxHeight="220" BorderThickness="0"
                             Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="{DynamicResource FilesToConvert}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="6,3" />
                                <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="170" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <c:FormatBadge Label="{Binding TypeLabel}" Category="{Binding Category}" Width="26" Height="26" Margin="0,0,10,0" />
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="13" Foreground="{DynamicResource Brush.Text}">
                                        <Run Text="{Binding Name, Mode=OneWay, Converter={StaticResource LocalizedString}}" /><Run Text="  " /><Run Text="{Binding SizeText, Mode=OneWay, Converter={StaticResource LocalizedString}}" FontFamily="{StaticResource MonoFont}"
                                                                                                        FontSize="11" Foreground="{DynamicResource Brush.TextTertiary}" />
                                    </TextBlock>
                                    <ComboBox Grid.Column="2" ItemsSource="{Binding Targets}" SelectedItem="{Binding SelectedTarget}" DisplayMemberPath="Label"
                                              Margin="8,0" MinWidth="150" AutomationProperties.Name="{DynamicResource OutputFormatThisFile}"
                                              Visibility="{Binding DataContext.PerFileOptions, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}" />
                                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                                        <Button Content="&#xE70E;" Style="{StaticResource IconButton}" ToolTip="{DynamicResource MoveUp}" Width="28" Height="28"
                                                Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        <Button Content="&#xE70D;" Style="{StaticResource IconButton}" ToolTip="{DynamicResource MoveDown}" Width="28" Height="28"
                                                Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    </StackPanel>
                                    <Button Grid.Column="4" Content="&#xE711;" Style="{StaticResource IconButton}" ToolTip="{DynamicResource RemoveList}" Width="28" Height="28"
                                            Command="{Binding DataContext.RemoveFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
                <TextBlock Text="{DynamicResource AnalyzingFiles}" Style="{StaticResource Text.Caption}" Margin="0,8,0,0"
                           Visibility="{Binding IsAnalyzing, Converter={StaticResource BoolToVisibility}}" />
                <CheckBox Content="{DynamicResource PerFileOptions}" IsChecked="{Binding PerFileOptions}" Margin="4,10,0,0"
                          Visibility="{Binding HasSeveralFiles, Converter={StaticResource BoolToVisibility}}" />

                <!-- Output format -->
                <StackPanel Margin="0,20,0,0" Visibility="{Binding HasFiles, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{DynamicResource OutputFormat}" Style="{StaticResource Text.Section}" />
                    <TextBlock Text="{Binding TargetsMessage, Converter={StaticResource LocalizedString}}" Style="{StaticResource Text.Secondary}" Foreground="{DynamicResource Brush.Warning}" Margin="0,0,0,8"
                               Visibility="{Binding TargetsMessage, Converter={StaticResource NullToVisibility}}" />
                    <ListBox ItemsSource="{Binding Targets}" SelectedItem="{Binding SelectedTarget}" Style="{StaticResource FormatTiles}"
                             AutomationProperties.Name="{DynamicResource OutputFormats}" />
                    <StackPanel DataContext="{Binding SelectedTarget}" Visibility="{Binding Converter={StaticResource NullToVisibility}}">
                        <TextBlock Text="{Binding Target.Description, Converter={StaticResource LocalizedString}}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Danger}" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding IsAvailable, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                            <Run Text="{DynamicResource UnavailablePrefix}" FontWeight="SemiBold" /><Run Text="{Binding Target.UnavailableReason, Mode=OneWay, Converter={StaticResource LocalizedString}}" />
                        </TextBlock>
                        <TextBlock Text="{Binding Target.Limitations, Converter={StaticResource LocalizedString}}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Visibility="{Binding Target.Limitations, Converter={StaticResource NullToVisibility}}" />
                    </StackPanel>
                </StackPanel>

                <!-- Image quality with a measured size -->
                <Grid Margin="0,20,0,0" Visibility="{Binding ShowImageOptions, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}" Padding="16">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding ImageQuality, Converter={StaticResource LocalizedString}}" FontFamily="{StaticResource MonoFont}" FontSize="14" Foreground="{DynamicResource Brush.Text}" />
                                <TextBlock Text="{DynamicResource Quality}" FontSize="14" Foreground="{DynamicResource Brush.Text}" />
                            </DockPanel>
                            <Slider Minimum="1" Maximum="100" Value="{Binding ImageQuality}" IsSnapToTickEnabled="True" TickFrequency="1" Margin="0,10,0,0"
                                    AutomationProperties.Name="{DynamicResource Quality}" ToolTip="{DynamicResource LossyFormatsHint}" />
                            <TextBlock Text="{Binding EstimateText, TargetNullValue='Lossless formats ignore quality.', Converter={StaticResource LocalizedString}}" Style="{StaticResource Text.Caption}"
                                       TextWrapping="Wrap" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding ResizeText, Converter={StaticResource LocalizedString}}" Style="{StaticResource Text.Mono}" FontSize="13" ToolTip="{DynamicResource MaxSizeHint}" />
                                <TextBlock Text="{DynamicResource ResizeMax}" FontSize="14" Foreground="{DynamicResource Brush.Text}" />
                            </DockPanel>
                            <DockPanel Margin="0,12,0,0">
                                <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding StripMetadata}" AutomationProperties.Name="{DynamicResource StripMetadata}" />
                                <TextBlock Text="{DynamicResource StripMetadata}" FontSize="14" Foreground="{DynamicResource Brush.Text}" VerticalAlignment="Center" />
                            </DockPanel>
                            <DockPanel Margin="0,12,0,0">
                                <TextBlock DockPanel.Dock="Right" Text="{DynamicResource Auto}" Style="{StaticResource Text.Mono}" FontSize="13"
                                           ToolTip="{DynamicResource TransparencyHint}" />
                                <TextBlock Text="{DynamicResource KeepTransparency}" FontSize="14" Foreground="{DynamicResource Brush.Text}" />
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- All options -->
                <Border Style="{StaticResource Card}" Padding="16" Margin="0,12,0,0" Visibility="{Binding HasOptions, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="{DynamicResource ResetDefaults}" Style="{StaticResource SubtleButton}" FontSize="12" Command="{Binding ResetOptionsCommand}" />
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Options}" Style="{StaticResource Text.Subtitle}" />
                                <TextBlock Text="{Binding OptionsScopeText, Converter={StaticResource LocalizedString}}" Style="{StaticResource Text.Caption}" />
                            </StackPanel>
                        </DockPanel>

                        <!-- Image -->
                        <StackPanel Style="{StaticResource OptionGroup}" Visibility="{Binding ShowImageOptions, Converter={StaticResource BoolToVisibility}}">
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource MaxWidthPx}" Style="{StaticResource OptionLabel}" />
                                    <TextBox Text="{Binding EditingOptions.Image.MaxWidth, TargetNullValue={x:Static sys:String.Empty}, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="{DynamicResource MaximumWidthPixels}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{DynamicResource MaxHeightPx}" Style="{StaticResource OptionLabel}" />
                                    <TextBox Text="{Binding EditingOptions.Image.MaxHeight, TargetNullValue={x:Static sys:String.Empty}, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="{DynamicResource MaximumHeightPixels}" />
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="{DynamicResource Rotate}" Style="{StaticResource OptionLabel}" />
                                    <ComboBox ItemsSource="{Binding Rotations}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                              SelectedValue="{Binding EditingOptions.Image.Rotation}" AutomationProperties.Name="{DynamicResource Rotation}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{DynamicResource ResizeHint}" Style="{StaticResource Text.Caption}" Margin="0,4,0,0" />
                            <TextBlock Text="{DynamicResource CropPixels}" Style="{StaticResource OptionLabel}" />
                            <UniformGrid Columns="4">
                                <TextBox Margin="0,0,6,0" Text="{Binding EditingOptions.Image.CropX, TargetNullValue={x:Static sys:String.Empty}}" AutomationProperties.Name="{DynamicResource CropLeft}" />
                                <TextBox Margin="0,0,6,0" Text="{Binding EditingOptions.Image.CropY, TargetNullValue={x:Static sys:String.Empty}}" AutomationProperties.Name="{DynamicResource CropTop}" />
                                <TextBox Margin="0,0,6,0" Text="{Binding EditingOptions.Image.CropWidth, TargetNullValue={x:Static sys:String.Empty}}" AutomationProperties.Name="{DynamicResource CropWidth}" />
                                <TextBox Text="{Binding EditingOptions.Image.CropHeight, TargetNullValue={x:Static sys:String.Empty}}" AutomationProperties.Name="{DynamicResource CropHeight}" />
                            </UniformGrid>
                            <WrapPanel Margin="0,12,0,0">
                                                                <CheckBox Content="{DynamicResource ConvertSrgb}" IsChecked="{Binding EditingOptions.Image.ConvertToSrgb}" Margin="0,0,18,6" />
                                <CheckBox Content="{DynamicResource KeepAnimation}" IsChecked="{Binding EditingOptions.Image.KeepAnimation}" Margin="0,0,18,6" />
                            </WrapPanel>
                            <TextBlock Text="{DynamicResource TransparentBackground}" Style="{StaticResource OptionLabel}" />
                            <TextBox Text="{Binding EditingOptions.Image.BackgroundColor}" Width="120" HorizontalAlignment="Left" AutomationProperties.Name="{DynamicResource BackgroundColor}" />
                        </StackPanel>

                        <!-- Video -->
                        <StackPanel Style="{StaticResource OptionGroup}" Visibility="{Binding ShowVideoOptions, Converter={StaticResource BoolToVisibility}}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Resolution}" Style="{StaticResource OptionLabel}" />
                                    <ComboBox ItemsSource="{Binding Resolutions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding EditingOptions.Video.Resolution}" AutomationProperties.Name="{DynamicResource Resolution}" />
                                    <TextBlock Text="{DynamicResource Quality}" Style="{StaticResource OptionLabel}" />
                                    <ComboBox ItemsSource="{Binding VideoQualities}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding EditingOptions.Video.Quality}" AutomationProperties.Name="{DynamicResource VideoQuality}" />
                                    <TextBlock Text="{DynamicResource AudioBitrate}" Style="{StaticResource OptionLabel}" />
                                    <ComboBox ItemsSource="{Binding Bitrates}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding EditingOptions.Video.AudioBitrateKbps}" AutomationProperties.Name="{DynamicResource AudioBitrate}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{DynamicResource VideoCodec}" Style="{StaticResource OptionLabel}" />
                                    <ComboBox ItemsSource="{Binding Codecs}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding EditingOptions.Video.Codec}" AutomationProperties.Name="{DynamicResource VideoCodec}" />
                                    <TextBlock Text="{DynamicResource FrameRate}" Style="{StaticResource OptionLabel}" />
                                    <ComboBox ItemsSource="{Binding FrameRates}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding EditingOptions.Video.FrameRate}" AutomationProperties.Name="{DynamicResource FrameRate}" />
                                    <CheckBox Content="{DynamicResource RemoveAudio}" IsChecked="{Binding EditingOptions.Video.RemoveAudio}" Margin="0,18,0,0" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{DynamicResource Trim}" Style="{StaticResource OptionLabel}" />
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <TextBox Text="{Binding EditingOptions.Video.TrimStart, TargetNullValue={x:Static sys:String.Empty}}" AutomationProperties.Name="{DynamicResource TrimStart}" ToolTip="{DynamicResource TrimStartExample}" />
                                <TextBox Grid.Column="2" Text="{Binding EditingOptions.Video.TrimEnd, TargetNullValue={x:Static sys:String.Empty}}" AutomationProperties.Name="{DynamicResource TrimEnd}" ToolTip="{DynamicResource TrimEndExample}" />
                            </Grid>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Subtitles}" Style="{StaticResource OptionLabel}" />
                                    <ComboBox ItemsSource="{Binding SubtitleModes}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding EditingOptions.Video.Subtitles}" AutomationProperties.Name="{DynamicResource SubtitleHandling}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{DynamicResource SubtitleTrackHint}" Style="{StaticResource OptionLabel}" />
                                    <TextBox Text="{Binding EditingOptions.Video.SubtitleStreamIndex, TargetNullValue={x:Static sys:String.Empty}}" AutomationProperties.Name="{DynamicResource SubtitleTrack}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <!-- GIF -->
                        <StackPanel Style="{StaticResource OptionGroup}" Visibility="{Binding ShowGifOptions, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource OptionLabel}"><Run Text="{DynamicResource GifFrameRateColon}" /><Run Text="{Binding EditingOptions.Video.GifFps, Mode=OneWay, Converter={StaticResource LocalizedString}}" FontWeight="SemiBold" /><Run Text="{DynamicResource Fps}" /></TextBlock>
                            <Slider Minimum="5" Maximum="30" Value="{Binding EditingOptions.Video.GifFps}" IsSnapToTickEnabled="True" TickFrequency="1" AutomationProperties.Name="{DynamicResource GifFrameRate}" />
                            <TextBlock Text="{DynamicResource GifMaxWidthPx}" Style="{StaticResource OptionLabel}" />
                            <TextBox Text="{Binding EditingOptions.Video.GifMaxWidth}" Width="120" HorizontalAlignment="Left" AutomationProperties.Name="{DynamicResource GifMaxWidth}" />
                        </StackPanel>

                        <!-- Audio -->
                        <StackPanel Style="{StaticResource OptionGroup}" Visibility="{Binding ShowAudioOptions, Converter={StaticResource BoolToVisibility}}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource LossyBitrate}" Style="{StaticResource OptionLabel}" />
                                    <ComboBox ItemsSource="{Binding Bitrates}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding EditingOptions.Audio.BitrateKbps}" AutomationProperties.Name="{DynamicResource AudioBitrate}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{DynamicResource SampleRate}" Style="{StaticResource OptionLabel}" />
                                    <ComboBox ItemsSource="{Binding SampleRates}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding EditingOptions.Audio.SampleRate}" AutomationProperties.Name="{DynamicResource SampleRate}" />
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="{DynamicResource Channels}" Style="{StaticResource OptionLabel}" />
                                    <ComboBox ItemsSource="{Binding ChannelChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding EditingOptions.Audio.Channels}" AutomationProperties.Name="{DynamicResource Channels}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{DynamicResource Trim}" Style="{StaticResource OptionLabel}" />
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <TextBox Text="{Binding EditingOptions.Audio.TrimStart, TargetNullValue={x:Static sys:String.Empty}}" AutomationProperties.Name="{DynamicResource TrimStart}" />
                                <TextBox Grid.Column="2" Text="{Binding EditingOptions.Audio.TrimEnd, TargetNullValue={x:Static sys:String.Empty}}" AutomationProperties.Name="{DynamicResource TrimEnd}" />
                            </Grid>
                        </StackPanel>

                        <!-- PDF -->
                        <StackPanel Style="{StaticResource OptionGroup}" Visibility="{Binding ShowPdfPages, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding PdfPagesHint, Converter={StaticResource LocalizedString}}" Style="{StaticResource OptionLabel}" />
                            <TextBox Text="{Binding PdfPageRange, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{DynamicResource PageRange}" />
                            <TextBlock Text="{DynamicResource PageRangeRequired}"
                                       Foreground="{DynamicResource Brush.Danger}" FontSize="12" Margin="2,6,0,0"
                                       Visibility="{Binding IsPageRangeMissing, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource OptionGroup}" Visibility="{Binding ShowPdfRotate, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{DynamicResource Rotation}" Style="{StaticResource OptionLabel}" />
                            <ComboBox ItemsSource="{Binding PdfRotations}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding EditingOptions.Pdf.RotationDegrees}" AutomationProperties.Name="{DynamicResource Rotation}" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource OptionGroup}" Visibility="{Binding ShowPdfDpi, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{DynamicResource Resolution}" Style="{StaticResource OptionLabel}" />
                            <ComboBox ItemsSource="{Binding Dpis}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding EditingOptions.Pdf.ImageDpi}" AutomationProperties.Name="{DynamicResource Resolution}" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource OptionGroup}" Visibility="{Binding ShowPdfCompression, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{DynamicResource Compression}" Style="{StaticResource OptionLabel}" />
                            <ComboBox ItemsSource="{Binding PdfCompressionLevels}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding EditingOptions.Pdf.Compression}" AutomationProperties.Name="{DynamicResource CompressionLevel}" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource OptionGroup}" Visibility="{Binding ShowPdfOcr, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{DynamicResource OcrLanguage}" Style="{StaticResource OptionLabel}" />
                            <ComboBox ItemsSource="{Binding OcrLanguages}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                      SelectedValue="{Binding EditingOptions.Pdf.OcrLanguage}" AutomationProperties.Name="{DynamicResource OcrLanguage}" />
                            <TextBlock Text="{DynamicResource OcrHint}"
                                       Style="{StaticResource Text.Caption}" Margin="0,6,0,0" TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- Document -->
                        <StackPanel Style="{StaticResource OptionGroup}" Visibility="{Binding ShowDocumentOptions, Converter={StaticResource BoolToVisibility}}">
                            <CheckBox Content="{DynamicResource AllowLocalDocuments}" IsChecked="{Binding EditingOptions.Document.AllowLocalResources}" Margin="0,12,0,4" />
                            <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                                       Text="{DynamicResource LocalResourcesSafety}" />
                        </StackPanel>

                        <!-- Archive -->
                        <StackPanel Style="{StaticResource OptionGroup}" Visibility="{Binding ShowArchiveOptions, Converter={StaticResource BoolToVisibility}}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource ArchiveNameOptional}" Style="{StaticResource OptionLabel}" />
                                    <TextBox Text="{Binding EditingOptions.Archive.ArchiveName}" AutomationProperties.Name="{DynamicResource ArchiveName}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{DynamicResource Compression}" Style="{StaticResource OptionLabel}" />
                                    <ComboBox ItemsSource="{Binding ArchiveLevels}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding EditingOptions.Archive.Compression}" AutomationProperties.Name="{DynamicResource Compression}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Output panel -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" VerticalAlignment="Top">
            <StackPanel>
                <Border CornerRadius="14" Padding="20" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Output}" Style="{StaticResource Text.Mono}" FontSize="12" />
                        <TextBlock Text="{Binding OutputName, Converter={StaticResource LocalizedString}}" FontFamily="{StaticResource MonoFont}" FontSize="15" TextWrapping="Wrap" Margin="0,14,0,0"
                                   Foreground="{DynamicResource Brush.Text}" />
                        <TextBlock Text="{Binding LocationText, Converter={StaticResource LocalizedString}}" Style="{StaticResource Text.Caption}" FontSize="13" TextWrapping="Wrap" Margin="0,14,0,0" />
                        <TextBlock Text="{Binding CollisionText, Converter={StaticResource LocalizedString}}" Style="{StaticResource Text.Caption}" FontSize="13" Margin="0,14,0,0" />
                        <ProgressBar Style="{StaticResource SlimProgress}" Height="6" Margin="0,14,0,0" Maximum="100" Background="{DynamicResource Brush.Track}"
                                     Value="{Binding LastBatch.Progress, Mode=OneWay, Converter={StaticResource ProgressPercent}, FallbackValue=0}" />
                        <TextBlock Text="{Binding BatchStatus, Converter={StaticResource LocalizedString}}" FontSize="13" Margin="0,14,0,0" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding BatchDone}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.AccentText}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding BatchFailed}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Button Style="{StaticResource PrimaryButton}" Command="{Binding StartCommand}" Content="{Binding StartLabel, Converter={StaticResource LocalizedString}}" Padding="11"
                                    AutomationProperties.Name="{DynamicResource StartConversion}" />
                            <Button Grid.Column="1" Content="{DynamicResource Folder}" Style="{StaticResource OutlineButton}" FontSize="14" Padding="14,11" Margin="8,0,0,0"
                                    Command="{Binding OpenOutputFolderCommand}" ToolTip="{DynamicResource ShowOutputHint}" />
                        </Grid>
                        <Button Content="{DynamicResource CancelBatch}" Style="{StaticResource SubtleButton}" FontSize="12" HorizontalAlignment="Left" Margin="0,8,0,0"
                                Command="{Binding CancelBatchCommand}"
                                Visibility="{Binding LastBatch.IsCompleted, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert, FallbackValue=Collapsed}" />
                        <TextBlock Text="{Binding StatusMessage, Converter={StaticResource LocalizedString}}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,10,0,0"
                                   Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibility}}" />
                        <Button Content="{DynamicResource OpenBatch}" Command="{Binding ShowBatchCommand}" Cursor="Hand" Margin="0,10,0,0" HorizontalAlignment="Left"
                                Foreground="{DynamicResource Brush.AccentText}" FontSize="13">
                            <Button.Template>
                                <ControlTemplate TargetType="Button"><ContentPresenter /></ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Where to save -->
                <Border Style="{StaticResource Card}" Padding="16" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource SaveTo}" Style="{StaticResource Text.Subtitle}" FontSize="14" Margin="0,0,0,8" />
                        <RadioButton Content="{DynamicResource BesideOriginalFiles}" IsChecked="{Binding SaveBesideOriginal}" GroupName="Output" Margin="0,0,0,6" />
                        <RadioButton Content="{DynamicResource FolderColon}" GroupName="Output" IsChecked="{Binding SaveBesideOriginal, Converter={StaticResource InverseBool}}" />
                        <DockPanel Margin="0,6,0,0">
                            <Button DockPanel.Dock="Right" Content="{DynamicResource Browse}" Style="{StaticResource OutlineButton}" Margin="8,0,0,0" Command="{Binding BrowseOutputFolderCommand}" />
                            <TextBox Text="{Binding OutputFolder}" IsEnabled="{Binding SaveBesideOriginal, Converter={StaticResource InverseBool}}"
                                     FontFamily="{StaticResource MonoFont}" FontSize="12" AutomationProperties.Name="{DynamicResource OutputFolder}" />
                        </DockPanel>
                        <TextBlock Text="{DynamicResource SameName}" Style="{StaticResource OptionLabel}" />
                        <ComboBox ItemsSource="{Binding CollisionChoices}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                  SelectedValue="{Binding Collision}" AutomationProperties.Name="{DynamicResource NameCollision}" />
                        <TextBlock Text="{DynamicResource NeverOverwriteShort}" Style="{StaticResource Text.Caption}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <!-- Save as preset -->
                <Border Style="{StaticResource Card}" Padding="16" Margin="0,12,0,0" Visibility="{Binding HasFiles, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource SavePreset}" Style="{StaticResource Text.Subtitle}" FontSize="14" />
                        <TextBlock Text="{DynamicResource PresetSaveHint}" Style="{StaticResource Text.Caption}"
                                   TextWrapping="Wrap" Margin="0,4,0,8" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="{DynamicResource Save}" Style="{StaticResource OutlineButton}" Margin="8,0,0,0" Command="{Binding SaveAsPresetCommand}" />
                            <TextBox Text="{Binding PresetName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{DynamicResource PresetName}"
                                     ToolTip="{DynamicResource PresetNameOptional}" />
                        </DockPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
