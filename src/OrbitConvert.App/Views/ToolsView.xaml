<UserControl x:Class="OrbitConvert.App.Views.ToolsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <DataTemplate x:Key="ToolCardTemplate">
            <Button Margin="0,0,12,12" Style="{StaticResource SubtleButton}" Padding="0" HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch"
                    Command="{Binding DataContext.RunCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                    AutomationProperties.Name="{Binding Title}" AutomationProperties.HelpText="{Binding Description}">
                <Border Style="{StaticResource Card}" Padding="16" HorizontalAlignment="Stretch">
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="10" VerticalAlignment="Top"
                                Background="{Binding Category, Converter={StaticResource CategoryToBrush}}">
                            <TextBlock Text="{Binding Glyph}" Style="{StaticResource Glyph}" Foreground="White" FontSize="18" />
                        </Border>
                        <StackPanel Margin="14,0,0,0">
                            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Subtitle}" FontSize="14" />
                            <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Secondary}" FontSize="12" Margin="0,2,0,0" />
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Button>
        </DataTemplate>
        <ItemsPanelTemplate x:Key="ThreeColumns">
            <UniformGrid Columns="3" />
        </ItemsPanelTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="40,32,40,32" MaxWidth="1040">
            <TextBlock Text="PDF &amp; archive tools" Style="{StaticResource Text.Display}" />
            <TextBlock Text="Pick a tool, choose files, then review options on the Convert page." Style="{StaticResource Text.Secondary}" Margin="0,4,0,24" />

            <TextBlock Text="PDF" Style="{StaticResource Text.Section}" />
            <ItemsControl ItemsSource="{Binding PdfTools}" ItemTemplate="{StaticResource ToolCardTemplate}" ItemsPanel="{StaticResource ThreeColumns}" Focusable="False" />

            <TextBlock Text="ARCHIVES" Style="{StaticResource Text.Section}" Margin="0,18,0,8" />
            <ItemsControl ItemsSource="{Binding ArchiveTools}" ItemTemplate="{StaticResource ToolCardTemplate}" ItemsPanel="{StaticResource ThreeColumns}" Focusable="False" />

            <TextBlock Text="INSPECT" Style="{StaticResource Text.Section}" Margin="0,18,0,8" />
            <StackPanel Orientation="Horizontal">
                <Button Command="{Binding InspectPdfCommand}" Margin="0,0,10,0" Padding="14,8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE946;" Style="{StaticResource Glyph}" FontSize="13" Margin="0,0,8,0" Foreground="{DynamicResource Brush.Text}" />
                        <TextBlock Text="PDF information…" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding TestArchiveCommand}" Padding="14,8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE73E;" Style="{StaticResource Glyph}" FontSize="13" Margin="0,0,8,0" Foreground="{DynamicResource Brush.Text}" />
                        <TextBlock Text="Verify archive integrity…" />
                    </StackPanel>
                </Button>
                <TextBlock Text="Working…" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" Margin="12,0,0,0"
                           Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
            <Border Style="{StaticResource Card}" Margin="0,12,0,0" Visibility="{Binding InspectResult, Converter={StaticResource NullToVisibility}}">
                <StackPanel>
                    <TextBlock Text="{Binding InspectTitle}" Style="{StaticResource Text.Subtitle}" Margin="0,0,0,8" />
                    <TextBox Text="{Binding InspectResult, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0"
                             Background="Transparent" FontFamily="Cascadia Mono, Consolas" FontSize="12.5"
                             AutomationProperties.Name="Inspection result" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
