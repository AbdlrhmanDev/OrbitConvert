<UserControl x:Class="OrbitConvert.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:OrbitConvert.App.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="40,32,40,32" MaxWidth="1000">
            <TextBlock Text="Convert anything, right here" Style="{StaticResource Text.Display}" />
            <TextBlock Style="{StaticResource Text.Secondary}" FontSize="14" Margin="0,6,0,24"
                       Text="Files never leave this computer. Drop files below, use the radial menu from File Explorer, or press your shortcut." />

            <!-- Drop area -->
            <Border x:Name="DropArea" CornerRadius="14" Padding="32" MinHeight="230" AllowDrop="True" Cursor="Hand"
                    Background="{DynamicResource Brush.Surface}" Drop="OnDrop" DragEnter="OnDragEnter" DragLeave="OnDragLeave"
                    MouseLeftButtonUp="OnDropAreaClick" AutomationProperties.Name="Drop area. Drop files here or click to choose files.">
                <Grid>
                    <Rectangle x:Name="DashedBorder" RadiusX="14" RadiusY="14" Margin="-32" StrokeThickness="2" StrokeDashArray="5 4"
                               Stroke="{DynamicResource Brush.BorderStrong}" />
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Grid Width="132" Height="74" Margin="0,0,0,14">
                            <c:FormatBadge Label="JPG" Category="Image" Width="40" Height="48" HorizontalAlignment="Left" VerticalAlignment="Bottom">
                                <c:FormatBadge.RenderTransform><RotateTransform Angle="-12" /></c:FormatBadge.RenderTransform>
                            </c:FormatBadge>
                            <c:FormatBadge Label="MP4" Category="Video" Width="40" Height="48" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                <c:FormatBadge.RenderTransform><RotateTransform Angle="12" CenterX="40" CenterY="48" /></c:FormatBadge.RenderTransform>
                            </c:FormatBadge>
                            <c:FormatBadge Label="PDF" Category="Pdf" Width="46" Height="55" HorizontalAlignment="Center" VerticalAlignment="Top" />
                        </Grid>
                        <TextBlock Text="Drop files here" Style="{StaticResource Text.Title}" HorizontalAlignment="Center" />
                        <TextBlock Text="Images, video, audio, documents, PDFs and archives" Style="{StaticResource Text.Secondary}"
                                   HorizontalAlignment="Center" Margin="0,4,0,16" />
                        <Button Content="Select files" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center"
                                Command="{Binding SelectFilesCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Quick categories -->
            <TextBlock Text="QUICK START" Style="{StaticResource Text.Section}" Margin="0,30,0,10" />
            <ItemsControl ItemsSource="{Binding Categories}" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Margin="0,0,12,12" Style="{StaticResource SubtleButton}" Padding="0" HorizontalContentAlignment="Stretch"
                                Command="{Binding DataContext.OpenCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" AutomationProperties.Name="{Binding Title}">
                            <Border Style="{StaticResource Card}" Padding="16,14" HorizontalAlignment="Stretch">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="38" Height="38" CornerRadius="10" Background="{Binding Category, Converter={StaticResource CategoryToBrush}}">
                                        <TextBlock Text="{Binding Glyph}" Style="{StaticResource Glyph}" Foreground="White" FontSize="17" />
                                    </Border>
                                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Subtitle}" FontSize="14" />
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Caption}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Recent conversions -->
            <DockPanel Margin="0,20,0,10">
                <Button DockPanel.Dock="Right" Content="View all" Style="{StaticResource SubtleButton}" FontSize="12" Command="{Binding ShowHistoryCommand}" />
                <TextBlock Text="RECENT CONVERSIONS" Style="{StaticResource Text.Section}" VerticalAlignment="Center" Margin="0" />
            </DockPanel>
            <Border Style="{StaticResource Card}" Padding="6">
                <Grid>
                    <ItemsControl ItemsSource="{Binding Recent}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="10,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="StatusGlyph" Text="&#xE73E;" Style="{StaticResource Glyph}" HorizontalAlignment="Left"
                                               Foreground="{DynamicResource Brush.Success}" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Style="{StaticResource Text.Body}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
                                            <Run Text="{Binding InputSummary, Mode=OneWay}" /><Run Text="  →  " Foreground="{DynamicResource Brush.TextTertiary}" /><Run Text="{Binding TargetLabel, Mode=OneWay}" FontWeight="SemiBold" />
                                        </TextBlock>
                                        <TextBlock x:Name="ErrorText" Text="{Binding Error}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Danger}"
                                                   TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding Timestamp, Converter={StaticResource RelativeTime}}" Style="{StaticResource Text.Caption}"
                                               VerticalAlignment="Center" Margin="12,0" />
                                    <Button Grid.Column="3" Content="&#xE8B7;" Style="{StaticResource IconButton}" ToolTip="Show in folder"
                                            Command="{Binding DataContext.RevealCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Succeeded}" Value="False">
                                        <Setter TargetName="StatusGlyph" Property="Text" Value="&#xE783;" />
                                        <Setter TargetName="StatusGlyph" Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                                        <Setter TargetName="ErrorText" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Nothing converted yet. Your recent conversions will appear here." Style="{StaticResource Text.Secondary}"
                               Margin="14,16" Visibility="{Binding HasRecent, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
