<UserControl x:Class="OrbitConvert.App.Views.BatchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Columns: type, file, output, progress, actions -->
        <Style x:Key="RowGrid" TargetType="Grid">
            <Setter Property="Margin" Value="14,0" />
        </Style>
    </UserControl.Resources>
    <DockPanel Margin="32">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,20">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button Content="Clear finished" Style="{StaticResource OutlineButton}" Command="{Binding ClearFinishedCommand}" Margin="0,0,8,0" />
                <Button Content="Pause queue" Style="{StaticResource OutlineButton}" Command="{Binding PauseQueueCommand}" Margin="0,0,8,0"
                        ToolTip="Hold the jobs that have not started. Running jobs finish."
                        Visibility="{Binding HasWaiting, Converter={StaticResource BoolToVisibility}}" />
                <Button Content="Resume queue" Style="{StaticResource OutlineButton}" Command="{Binding ResumeQueueCommand}" Margin="0,0,8,0"
                        Visibility="{Binding HasPaused, Converter={StaticResource BoolToVisibility}}" />
                <Button Content="Add files" Style="{StaticResource PrimaryButton}" FontSize="13" Padding="14,8" Command="{Binding AddFilesCommand}" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Batch" Style="{StaticResource Text.Display}" />
                <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Secondary}" FontSize="14" Foreground="{DynamicResource Brush.TextTertiary}" Margin="0,4,0,0" />
            </StackPanel>
        </DockPanel>

        <Border CornerRadius="12" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" ClipToBounds="True"
                Visibility="{Binding HasJobs, Converter={StaticResource BoolToVisibility}}" VerticalAlignment="Top">
            <DockPanel>
                <Border DockPanel.Dock="Top" Background="{DynamicResource Brush.Sidebar}" Padding="0,10" CornerRadius="11,11,0,0">
                    <Grid Style="{StaticResource RowGrid}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="54" /><ColumnDefinition Width="2*" /><ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1.4*" /><ColumnDefinition Width="170" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Type" Style="{StaticResource Text.Caption}" />
                        <TextBlock Grid.Column="1" Text="File" Style="{StaticResource Text.Caption}" Margin="14,0" />
                        <TextBlock Grid.Column="2" Text="Output" Style="{StaticResource Text.Caption}" Margin="0,0,14,0" />
                        <TextBlock Grid.Column="3" Text="Progress" Style="{StaticResource Text.Caption}" />
                        <TextBlock Grid.Column="4" Text="Actions" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right" />
                    </Grid>
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Jobs}" Focusable="False" AutomationProperties.Name="Conversion queue">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="0,12"
                                        AutomationProperties.Name="{Binding Title}">
                                    <Grid Style="{StaticResource RowGrid}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="54" /><ColumnDefinition Width="2*" /><ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="1.4*" /><ColumnDefinition Width="170" />
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource ExtTag}" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Plan.Inputs[0].Format.Label, FallbackValue=?}" Style="{StaticResource Text.Mono}" FontSize="11"
                                                       FontWeight="Bold" HorizontalAlignment="Center"
                                                       Foreground="{Binding Plan.Inputs[0].Format.Category, Converter={StaticResource CategoryToBrush}}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Plan.Inputs[0].FileName}" FontSize="14" Foreground="{DynamicResource Brush.Text}"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Plan.Inputs[0].Path}" />
                                            <TextBlock Text="{Binding Plan.Inputs.Count, StringFormat='{}{0} files combined into one output'}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Plan.Route.Kind}" Value="Combine">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding TimingText}" Style="{StaticResource Text.Caption}" FontFamily="{StaticResource MonoFont}"
                                                       Margin="0,3,0,0" Visibility="{Binding TimingText, Converter={StaticResource NullToVisibility}}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding Plan.Route.Label}" Style="{StaticResource Text.Mono}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" Margin="0,0,14,0" />
                                        <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                            <ProgressBar Style="{StaticResource SlimProgress}" Maximum="100" Background="{DynamicResource Brush.Track}"
                                                         Foreground="{Binding Status, Converter={StaticResource JobBarBrush}}">
                                                <ProgressBar.Value>
                                                    <MultiBinding Converter="{StaticResource JobBarValue}" Mode="OneWay">
                                                        <Binding Path="Status" />
                                                        <Binding Path="Progress" />
                                                    </MultiBinding>
                                                </ProgressBar.Value>
                                            </ProgressBar>
                                            <TextBlock Style="{StaticResource Text.Caption}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"
                                                       Foreground="{Binding Status, Converter={StaticResource JobStatusBrush}}" ToolTip="{Binding TechnicalDetail}">
                                                <TextBlock.Text>
                                                    <MultiBinding Converter="{StaticResource JobStatusLine}" Mode="OneWay">
                                                        <Binding Path="Status" />
                                                        <Binding Path="Progress" />
                                                        <Binding Path="Error" />
                                                        <Binding Path="Note" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Button Content="Pause" Style="{StaticResource SmallOutlineButton}" Margin="6,0,0,0"
                                                    Visibility="{Binding CanPause, Converter={StaticResource BoolToVisibility}}"
                                                    Command="{Binding DataContext.PauseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                            <Button Content="Resume" Style="{StaticResource SmallOutlineButton}" Margin="6,0,0,0"
                                                    Visibility="{Binding CanResume, Converter={StaticResource BoolToVisibility}}"
                                                    Command="{Binding DataContext.ResumeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                            <Button Content="Retry" Style="{StaticResource SmallOutlineButton}" Margin="6,0,0,0"
                                                    Visibility="{Binding CanRetry, Converter={StaticResource BoolToVisibility}}"
                                                    Command="{Binding DataContext.RetryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                            <Button Content="Show" Style="{StaticResource SmallOutlineButton}" Margin="6,0,0,0" ToolTip="Show in folder"
                                                    Visibility="{Binding IsFinished, Converter={StaticResource BoolToVisibility}}"
                                                    Command="{Binding DataContext.RevealCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                            <Button Content="Open" Style="{StaticResource SmallOutlineButton}" Margin="6,0,0,0" ToolTip="Open output"
                                                    Visibility="{Binding IsFinished, Converter={StaticResource BoolToVisibility}}"
                                                    Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                            <Button Content="✕" Style="{StaticResource SmallOutlineButton}" Margin="6,0,0,0" ToolTip="Cancel"
                                                    Foreground="{DynamicResource Brush.TextTertiary}"
                                                    Visibility="{Binding CanCancel, Converter={StaticResource BoolToVisibility}}"
                                                    Command="{Binding DataContext.CancelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                            <Button Content="✕" Style="{StaticResource SmallOutlineButton}" Margin="6,0,0,0" ToolTip="Remove from list"
                                                    Foreground="{DynamicResource Brush.TextTertiary}"
                                                    Visibility="{Binding IsFinished, Converter={StaticResource BoolToVisibility}}"
                                                    Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </DockPanel>
</UserControl>
