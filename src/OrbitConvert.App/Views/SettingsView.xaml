<UserControl x:Class="OrbitConvert.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="SectionCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="Padding" Value="22" />
        </Style>
        <Style x:Key="Row" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,6" />
            <Setter Property="LastChildFill" Value="True" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,6" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32" MaxWidth="880" HorizontalAlignment="Left">
            <TextBlock Text="{DynamicResource Settings}" Style="{StaticResource Text.Display}" Margin="0,0,0,4" />
            <TextBlock Text="{DynamicResource SettingsIntro}" Style="{StaticResource Text.Secondary}" FontSize="14" Foreground="{DynamicResource Brush.TextTertiary}" Margin="0,0,0,22" />

            <!-- Output -->
            <Border Style="{StaticResource SectionCard}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Output}" Style="{StaticResource Text.Subtitle}" Margin="0,0,0,8" />
                    <CheckBox Content="{DynamicResource SaveBesideOriginals}" IsChecked="{Binding SaveBesideOriginal}" />
                    <DockPanel Style="{StaticResource Row}" IsEnabled="{Binding SaveBesideOriginal, Converter={StaticResource InverseBool}}">
                        <TextBlock Text="{DynamicResource DefaultFolder}" Style="{StaticResource SettingLabel}" Width="150" />
                        <Button DockPanel.Dock="Right" Content="{DynamicResource Browse}" Margin="8,0,0,0" Command="{Binding BrowseOutputFolderCommand}" />
                        <TextBox Text="{Binding CustomOutputFolder}" AutomationProperties.Name="{DynamicResource DefaultOutputFolder}" />
                    </DockPanel>
                    <DockPanel Style="{StaticResource Row}">
                        <TextBlock Text="{DynamicResource NameCollisions}" Style="{StaticResource SettingLabel}" Width="150" />
                        <ComboBox ItemsSource="{Binding CollisionChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Collision}"
                                  Width="280" HorizontalAlignment="Left" AutomationProperties.Name="{DynamicResource NameCollisions}" />
                    </DockPanel>
                    <TextBlock Text="{DynamicResource NeverOverwrite}" Style="{StaticResource Hint}" />
                </StackPanel>
            </Border>

            <!-- Appearance -->
            <Border Style="{StaticResource SectionCard}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource AppearanceLanguage}" Style="{StaticResource Text.Subtitle}" Margin="0,0,0,8" />
                    <DockPanel Style="{StaticResource Row}">
                        <TextBlock Text="{DynamicResource Theme}" Style="{StaticResource SettingLabel}" Width="150" />
                        <ComboBox ItemsSource="{Binding Themes}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Theme}"
                                  Width="220" HorizontalAlignment="Left" AutomationProperties.Name="{DynamicResource Theme}" />
                    </DockPanel>
                    <DockPanel Style="{StaticResource Row}">
                        <TextBlock Text="{DynamicResource Language}" Style="{StaticResource SettingLabel}" Width="150" />
                        <ComboBox ItemsSource="{Binding Languages}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Language}"
                                  Width="220" HorizontalAlignment="Left" AutomationProperties.Name="{DynamicResource Language}" />
                    </DockPanel>
                    <TextBlock Text="{DynamicResource LanguageHint}" Style="{StaticResource Hint}" />
                </StackPanel>
            </Border>

            <!-- Activation -->
            <Border Style="{StaticResource SectionCard}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource QuickConversion}" Style="{StaticResource Text.Subtitle}" Margin="0,0,0,4" />
                    <TextBlock Text="{DynamicResource QuickConversionHint}" Style="{StaticResource Hint}" />

                    <CheckBox Content="{DynamicResource ExplorerMenu}" IsChecked="{Binding ContextMenuEnabled}" Margin="0,8,0,0" />
                    <TextBlock Text="{DynamicResource ExplorerMenuHint}" Style="{StaticResource Hint}" Margin="26,2,0,6" />
                    <CheckBox Content="{DynamicResource SendToMenu}" IsChecked="{Binding SendToEnabled}" />
                    <TextBlock Text="{Binding ShellMessage, Converter={StaticResource LocalizedString}}" Style="{StaticResource Hint}" Foreground="{DynamicResource Brush.Accent}" Margin="26,4,0,6"
                               Visibility="{Binding ShellMessage, Converter={StaticResource NullToVisibility}}" />

                    <CheckBox Content="{DynamicResource KeyboardShortcut}" IsChecked="{Binding HotkeyEnabled}" Margin="0,12,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="26,8,0,0" IsEnabled="{Binding HotkeyEnabled}">
                        <CheckBox Content="Ctrl" IsChecked="{Binding HotkeyCtrl}" Margin="0,0,12,0" />
                        <CheckBox Content="Alt" IsChecked="{Binding HotkeyAlt}" Margin="0,0,12,0" />
                        <CheckBox Content="Shift" IsChecked="{Binding HotkeyShift}" Margin="0,0,12,0" />
                        <CheckBox Content="Win" IsChecked="{Binding HotkeyWin}" Margin="0,0,12,0" />
                        <TextBlock Text="+" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource Brush.Text}" />
                        <TextBox Text="{Binding HotkeyKey, UpdateSourceTrigger=LostFocus}" Width="70" AutomationProperties.Name="{DynamicResource ShortcutKey}" />
                    </StackPanel>
                    <TextBlock Text="{Binding HotkeyStatus, Converter={StaticResource LocalizedString}}" Style="{StaticResource Hint}" Margin="26,6,0,6" />

                    <CheckBox Content="{DynamicResource FloatingDropZone}" IsChecked="{Binding DropZoneEnabled}" Margin="0,8,0,0" />
                    <TextBlock Text="{DynamicResource FloatingDropZoneHint}" Style="{StaticResource Hint}" Margin="26,2,0,6" />

                    <CheckBox IsChecked="{Binding ShakeToConvertEnabled}" Margin="0,8,0,0">
                        <TextBlock Foreground="{DynamicResource Brush.Text}"><Run Text="{DynamicResource ShakeToConvert}" /><Run Text="{DynamicResource Experimental}" Foreground="{DynamicResource Brush.Warning}" FontWeight="SemiBold" /></TextBlock>
                    </CheckBox>
                    <TextBlock Style="{StaticResource Hint}" Margin="26,2,0,0"
                               Text="{DynamicResource ShakeHint}" />
                </StackPanel>
            </Border>

            <!-- Behavior -->
            <Border Style="{StaticResource SectionCard}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Behavior}" Style="{StaticResource Text.Subtitle}" Margin="0,0,0,8" />
                    <CheckBox Content="{DynamicResource NotifyFinished}" IsChecked="{Binding NotificationsEnabled}" Margin="0,0,0,6" />
                    <CheckBox Content="{DynamicResource CloseRadial}" IsChecked="{Binding CloseRadialAfterSuccess}" Margin="0,0,0,6" />
                    <CheckBox Content="{DynamicResource ReduceMotion}" IsChecked="{Binding ReduceMotion}" Margin="0,0,0,6" />
                    <CheckBox Content="{DynamicResource StartWindows}" IsChecked="{Binding StartWithWindows}" Margin="0,0,0,6" />
                    <TextBlock Text="{DynamicResource StartWindowsHint}" Style="{StaticResource Hint}" Margin="26,0,0,6" />
                    <CheckBox Content="{DynamicResource KeepRunning}" IsChecked="{Binding RunInBackgroundWhenClosed}" Margin="0,0,0,6" />
                    <TextBlock Text="{DynamicResource KeepRunningHint}" Style="{StaticResource Hint}" Margin="26,0,0,6" />
                    <DockPanel Style="{StaticResource Row}">
                        <TextBlock Style="{StaticResource SettingLabel}" Width="220"><Run Text="{DynamicResource ParallelConversions}" /><Run Text="{Binding MaxParallelJobs, Mode=OneWay, Converter={StaticResource LocalizedString}}" FontWeight="SemiBold" /></TextBlock>
                        <Slider Minimum="1" Maximum="8" Value="{Binding MaxParallelJobs}" IsSnapToTickEnabled="True" TickFrequency="1" Width="240"
                                HorizontalAlignment="Left" AutomationProperties.Name="{DynamicResource ParallelConversionsLabel}" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Defaults -->
            <Border Style="{StaticResource SectionCard}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource QualityDefaults}" Style="{StaticResource Text.Subtitle}" Margin="0,0,0,8" />
                    <DockPanel Style="{StaticResource Row}">
                        <TextBlock Style="{StaticResource SettingLabel}" Width="220"><Run Text="{DynamicResource ImageQuality}" /><Run Text="{Binding DefaultImageQuality, Mode=OneWay, Converter={StaticResource LocalizedString}}" FontWeight="SemiBold" /></TextBlock>
                        <Slider Minimum="1" Maximum="100" Value="{Binding DefaultImageQuality}" IsSnapToTickEnabled="True" TickFrequency="1" Width="240"
                                HorizontalAlignment="Left" AutomationProperties.Name="{DynamicResource DefaultImageQuality}" />
                    </DockPanel>
                    <CheckBox Content="{DynamicResource RemoveMetadataDefault}" IsChecked="{Binding DefaultStripMetadata}" Margin="0,4,0,6" />
                    <DockPanel Style="{StaticResource Row}">
                        <TextBlock Text="{DynamicResource AudioBitrate}" Style="{StaticResource SettingLabel}" Width="220" />
                        <ComboBox ItemsSource="{Binding Bitrates}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding DefaultAudioBitrate}"
                                  Width="180" HorizontalAlignment="Left" AutomationProperties.Name="{DynamicResource DefaultAudioBitrate}" />
                    </DockPanel>
                    <DockPanel Style="{StaticResource Row}">
                        <TextBlock Text="{DynamicResource VideoQuality}" Style="{StaticResource SettingLabel}" Width="220" />
                        <ComboBox ItemsSource="{Binding VideoQualities}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding DefaultVideoQuality}"
                                  Width="180" HorizontalAlignment="Left" AutomationProperties.Name="{DynamicResource DefaultVideoQuality}" />
                    </DockPanel>
                    <DockPanel Style="{StaticResource Row}">
                        <TextBlock Text="{DynamicResource PdfResolution}" Style="{StaticResource SettingLabel}" Width="220" />
                        <ComboBox ItemsSource="{Binding Dpis}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding DefaultPdfDpi}"
                                  Width="180" HorizontalAlignment="Left" AutomationProperties.Name="{DynamicResource DefaultPdfResolution}" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Tools -->
            <Border Style="{StaticResource SectionCard}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource ConversionTools}" Style="{StaticResource Text.Subtitle}" Margin="0,0,0,4" />
                    <TextBlock Style="{StaticResource Hint}"
                               Text="{DynamicResource ToolsHint}" />
                    <ItemsControl ItemsSource="{Binding Tools}" Focusable="False" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12,10" Margin="0,0,0,6" CornerRadius="8" Background="{DynamicResource Brush.SurfaceAlt}">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="{DynamicResource Download}" Margin="4,0" Command="{Binding InstallCommand}" ToolTip="{DynamicResource DownloadVerifiedHint}"
                                                    Visibility="{Binding CanDownload, Converter={StaticResource BoolToVisibility}}" IsEnabled="{Binding IsInstalling, Converter={StaticResource InverseBool}}" />
                                            <Button Content="{DynamicResource Locate}" Margin="4,0" Command="{Binding BrowseCommand}" ToolTip="{DynamicResource LocateProgramHint}" />
                                            <Button Content="&#xE712;" Style="{StaticResource IconButton}" ToolTip="{DynamicResource More}" Click="OnMoreClick">
                                                <Button.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="{DynamicResource OpenWebsite}" Command="{Binding OpenHomepageCommand}" />
                                                        <MenuItem Header="{DynamicResource AutomaticDetection}" Command="{Binding ClearOverrideCommand}" IsEnabled="{Binding HasOverride}" />
                                                        <MenuItem Header="{DynamicResource RemoveDownloaded}" Command="{Binding RemoveCommand}" IsEnabled="{Binding InstalledByOrbitConvert}" />
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                            </Button>
                                        </StackPanel>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name, Converter={StaticResource LocalizedString}}" Style="{StaticResource Text.Subtitle}" FontSize="14" />
                                                <Border x:Name="Pill" CornerRadius="9" Padding="8,1" Margin="10,0,0,0" VerticalAlignment="Center" Background="{DynamicResource Brush.Success}">
                                                    <TextBlock Text="{Binding StatusText, Converter={StaticResource LocalizedString}}" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap">
                                                <Run Text="{Binding Purpose, Mode=OneWay, Converter={StaticResource LocalizedString}}" /><Run Text=" · " /><Run Text="{Binding License, Mode=OneWay, Converter={StaticResource LocalizedString}}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding Path, Converter={StaticResource LocalizedString}}" Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path, Converter={StaticResource LocalizedString}}"
                                                       Visibility="{Binding Path, Converter={StaticResource NullToVisibility}}" />
                                            <TextBlock Text="{Binding ProgressText, Converter={StaticResource LocalizedString}}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Accent}"
                                                       Visibility="{Binding ProgressText, Converter={StaticResource NullToVisibility}}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsFound}" Value="False">
                                        <Setter TargetName="Pill" Property="Background" Value="{DynamicResource Brush.TextTertiary}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Privacy -->
            <Border Style="{StaticResource SectionCard}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Privacy}" Style="{StaticResource Text.Subtitle}" Margin="0,0,0,6" />
                    <TextBlock Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,0,0,10"
                               Text="{DynamicResource PrivacyDescription}" />
                    <CheckBox Content="{DynamicResource KeepHistory}" IsChecked="{Binding KeepHistory}" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="{DynamicResource OpenDataFolder}" Command="{Binding OpenDataFolderCommand}" Margin="0,0,8,0" />
                        <Button Content="{DynamicResource OpenLogsFolder}" Command="{Binding OpenLogsFolderCommand}" />
                    </StackPanel>
                    <TextBlock Text="{Binding DataFolder, Converter={StaticResource LocalizedString}}" Style="{StaticResource Hint}" Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <!-- Updates -->
            <Border Style="{StaticResource SectionCard}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Updates}" Style="{StaticResource Text.Subtitle}" Margin="0,0,0,8" />
                    <CheckBox Content="{DynamicResource CheckUpdates}" IsChecked="{Binding CheckForUpdates}" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="{DynamicResource CheckNow}" Command="{Binding CheckNowCommand}" />
                        <Button Content="{DynamicResource DownloadInstall}" Margin="8,0,0,0" Command="{Binding InstallUpdateCommand}"
                                Visibility="{Binding CanInstallUpdate, Converter={StaticResource BoolToVisibility}}"
                                IsEnabled="{Binding IsInstallingUpdate, Converter={StaticResource InverseBool}}" />
                        <Button Content="{DynamicResource OpenRelease}" Margin="8,0,0,0" Command="{Binding OpenUpdateCommand}"
                                Visibility="{Binding UpdateUrl, Converter={StaticResource NullToVisibility}}" />
                    </StackPanel>
                    <TextBlock Text="{Binding UpdateStatus, Converter={StaticResource LocalizedString}}" Style="{StaticResource Hint}" Margin="0,6,0,0"
                               Visibility="{Binding UpdateStatus, Converter={StaticResource NullToVisibility}}" />
                    <TextBlock Text="{DynamicResource UpdateSafety}" Style="{StaticResource Hint}" />
                </StackPanel>
            </Border>

            <!-- About -->
            <Border Style="{StaticResource SectionCard}">
                <DockPanel>
                    <Image DockPanel.Dock="Left" Source="/OrbitConvert;component/Assets/logo-256.png" Width="56" Height="56" VerticalAlignment="Top" Margin="0,0,16,0" />
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Subtitle}"><Run Text="OrbitConvert " /><Run Text="{Binding Version, Mode=OneWay, Converter={StaticResource LocalizedString}}" /></TextBlock>
                        <TextBlock Text="{DynamicResource OpenSourceLine}" Style="{StaticResource Hint}" />
                        <TextBlock Text="{Binding EngineVersions, Converter={StaticResource LocalizedString}}" Style="{StaticResource Hint}" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="{DynamicResource ThirdPartyNotices}" Command="{Binding OpenNoticesCommand}" Margin="0,0,8,0" />
                            <Button Content="{DynamicResource ProjectGithub}" Command="{Binding OpenProjectPageCommand}" />
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
