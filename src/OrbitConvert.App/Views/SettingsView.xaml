<UserControl x:Class="OrbitConvert.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="SectionCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
        <Style x:Key="Row" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,6" />
            <Setter Property="LastChildFill" Value="True" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,6" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="40,32,40,32" MaxWidth="860">
            <TextBlock Text="Settings" Style="{StaticResource Text.Display}" Margin="0,0,0,20" />

            <!-- Output -->
            <Border Style="{StaticResource SectionCard}">
                <StackPanel>
                    <TextBlock Text="Output" Style="{StaticResource Text.Subtitle}" Margin="0,0,0,8" />
                    <CheckBox Content="Save converted files beside the originals" IsChecked="{Binding SaveBesideOriginal}" />
                    <DockPanel Style="{StaticResource Row}" IsEnabled="{Binding SaveBesideOriginal, Converter={StaticResource InverseBool}}">
                        <TextBlock Text="Default folder" Style="{StaticResource SettingLabel}" Width="150" />
                        <Button DockPanel.Dock="Right" Content="Browse…" Margin="8,0,0,0" Command="{Binding BrowseOutputFolderCommand}" />
                        <TextBox Text="{Binding CustomOutputFolder}" AutomationProperties.Name="Default output folder" />
                    </DockPanel>
                    <DockPanel Style="{StaticResource Row}">
                        <TextBlock Text="Name collisions" Style="{StaticResource SettingLabel}" Width="150" />
                        <ComboBox ItemsSource="{Binding CollisionChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Collision}"
                                  Width="280" HorizontalAlignment="Left" AutomationProperties.Name="Name collisions" />
                    </DockPanel>
                    <TextBlock Text="Original files are never overwritten, whichever option you choose." Style="{StaticResource Hint}" />
                </StackPanel>
            </Border>

            <!-- Appearance -->
            <Border Style="{StaticResource SectionCard}">
                <StackPanel>
                    <TextBlock Text="Appearance &amp; language" Style="{StaticResource Text.Subtitle}" Margin="0,0,0,8" />
                    <DockPanel Style="{StaticResource Row}">
                        <TextBlock Text="Theme" Style="{StaticResource SettingLabel}" Width="150" />
                        <ComboBox ItemsSource="{Binding Themes}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Theme}"
                                  Width="220" HorizontalAlignment="Left" AutomationProperties.Name="Theme" />
                    </DockPanel>
                    <DockPanel Style="{StaticResource Row}">
                        <TextBlock Text="Language" Style="{StaticResource SettingLabel}" Width="150" />
                        <ComboBox ItemsSource="{Binding Languages}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Language}"
                                  Width="220" HorizontalAlignment="Left" AutomationProperties.Name="Language" />
                    </DockPanel>
                    <TextBlock Text="English is the only translation so far. Translations are welcome — see CONTRIBUTING.md." Style="{StaticResource Hint}" />
                </StackPanel>
            </Border>

            <!-- Activation -->
            <Border Style="{StaticResource SectionCard}">
                <StackPanel>
                    <TextBlock Text="Quick conversion" Style="{StaticResource Text.Subtitle}" Margin="0,0,0,4" />
                    <TextBlock Text="Ways to open the radial menu without opening this window." Style="{StaticResource Hint}" />

                    <CheckBox Content="Explorer context menu: “Convert with OrbitConvert”" IsChecked="{Binding ContextMenuEnabled}" Margin="0,8,0,0" />
                    <TextBlock Text="Right-click files in File Explorer. On Windows 11 the entry is under “Show more options” (Shift+F10)." Style="{StaticResource Hint}" Margin="26,2,0,6" />
                    <CheckBox Content="“Send to” menu entry (passes all selected files at once)" IsChecked="{Binding SendToEnabled}" />
                    <TextBlock Text="{Binding ShellMessage}" Style="{StaticResource Hint}" Foreground="{DynamicResource Brush.Accent}" Margin="26,4,0,6"
                               Visibility="{Binding ShellMessage, Converter={StaticResource NullToVisibility}}" />

                    <CheckBox Content="Keyboard shortcut for files selected in File Explorer" IsChecked="{Binding HotkeyEnabled}" Margin="0,12,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="26,8,0,0" IsEnabled="{Binding HotkeyEnabled}">
                        <CheckBox Content="Ctrl" IsChecked="{Binding HotkeyCtrl}" Margin="0,0,12,0" />
                        <CheckBox Content="Alt" IsChecked="{Binding HotkeyAlt}" Margin="0,0,12,0" />
                        <CheckBox Content="Shift" IsChecked="{Binding HotkeyShift}" Margin="0,0,12,0" />
                        <CheckBox Content="Win" IsChecked="{Binding HotkeyWin}" Margin="0,0,12,0" />
                        <TextBlock Text="+" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource Brush.Text}" />
                        <TextBox Text="{Binding HotkeyKey, UpdateSourceTrigger=LostFocus}" Width="70" AutomationProperties.Name="Shortcut key" />
                    </StackPanel>
                    <TextBlock Text="{Binding HotkeyStatus}" Style="{StaticResource Hint}" Margin="26,6,0,6" />

                    <CheckBox Content="Floating drop zone (drag files onto it from anywhere)" IsChecked="{Binding DropZoneEnabled}" Margin="0,8,0,0" />
                    <TextBlock Text="A small always-on-top circle. Drag it to move it; right-click it to hide it." Style="{StaticResource Hint}" Margin="26,2,0,6" />

                    <CheckBox IsChecked="{Binding ShakeToConvertEnabled}" Margin="0,8,0,0">
                        <TextBlock Foreground="{DynamicResource Brush.Text}"><Run Text="Shake while dragging to show a drop target " /><Run Text="(experimental)" Foreground="{DynamicResource Brush.Warning}" FontWeight="SemiBold" /></TextBlock>
                    </CheckBox>
                    <TextBlock Style="{StaticResource Hint}" Margin="26,2,0,0"
                               Text="Uses a low-level mouse hook inside OrbitConvert (nothing is injected into Explorer). Windows cannot report whether files are being dragged, so any quick left-right shake with the button held shows the target; it ignores anything that is not a file." />
                </StackPanel>
            </Border>

            <!-- Behavior -->
            <Border Style="{StaticResource SectionCard}">
                <StackPanel>
                    <TextBlock Text="Behavior" Style="{StaticResource Text.Subtitle}" Margin="0,0,0,8" />
                    <CheckBox Content="Show a notification when conversions finish" IsChecked="{Binding NotificationsEnabled}" Margin="0,0,0,6" />
                    <CheckBox Content="Close the radial menu automatically after success" IsChecked="{Binding CloseRadialAfterSuccess}" Margin="0,0,0,6" />
                    <CheckBox Content="Keep running in the notification area when the window is closed" IsChecked="{Binding RunInBackgroundWhenClosed}" Margin="0,0,0,6" />
                    <TextBlock Text="Needed for the shortcut, drop zone and fast context-menu conversions." Style="{StaticResource Hint}" Margin="26,0,0,6" />
                    <DockPanel Style="{StaticResource Row}">
                        <TextBlock Style="{StaticResource SettingLabel}" Width="220"><Run Text="Parallel conversions: " /><Run Text="{Binding MaxParallelJobs, Mode=OneWay}" FontWeight="SemiBold" /></TextBlock>
                        <Slider Minimum="1" Maximum="8" Value="{Binding MaxParallelJobs}" IsSnapToTickEnabled="True" TickFrequency="1" Width="240"
                                HorizontalAlignment="Left" AutomationProperties.Name="Parallel conversions" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Defaults -->
            <Border Style="{StaticResource SectionCard}">
                <StackPanel>
                    <TextBlock Text="Quality defaults" Style="{StaticResource Text.Subtitle}" Margin="0,0,0,8" />
                    <DockPanel Style="{StaticResource Row}">
                        <TextBlock Style="{StaticResource SettingLabel}" Width="220"><Run Text="Image quality: " /><Run Text="{Binding DefaultImageQuality, Mode=OneWay}" FontWeight="SemiBold" /></TextBlock>
                        <Slider Minimum="1" Maximum="100" Value="{Binding DefaultImageQuality}" IsSnapToTickEnabled="True" TickFrequency="1" Width="240"
                                HorizontalAlignment="Left" AutomationProperties.Name="Default image quality" />
                    </DockPanel>
                    <CheckBox Content="Remove image metadata (EXIF, GPS) by default" IsChecked="{Binding DefaultStripMetadata}" Margin="0,4,0,6" />
                    <DockPanel Style="{StaticResource Row}">
                        <TextBlock Text="Audio bitrate" Style="{StaticResource SettingLabel}" Width="220" />
                        <ComboBox ItemsSource="{Binding Bitrates}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding DefaultAudioBitrate}"
                                  Width="180" HorizontalAlignment="Left" AutomationProperties.Name="Default audio bitrate" />
                    </DockPanel>
                    <DockPanel Style="{StaticResource Row}">
                        <TextBlock Text="Video quality" Style="{StaticResource SettingLabel}" Width="220" />
                        <ComboBox ItemsSource="{Binding VideoQualities}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding DefaultVideoQuality}"
                                  Width="180" HorizontalAlignment="Left" AutomationProperties.Name="Default video quality" />
                    </DockPanel>
                    <DockPanel Style="{StaticResource Row}">
                        <TextBlock Text="PDF to image resolution" Style="{StaticResource SettingLabel}" Width="220" />
                        <ComboBox ItemsSource="{Binding Dpis}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding DefaultPdfDpi}"
                                  Width="180" HorizontalAlignment="Left" AutomationProperties.Name="Default PDF resolution" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Tools -->
            <Border Style="{StaticResource SectionCard}">
                <StackPanel>
                    <TextBlock Text="Conversion tools" Style="{StaticResource Text.Subtitle}" Margin="0,0,0,4" />
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Image and PDF conversion is built in. Other formats use free tools that you install or let OrbitConvert download (only when you click Download)." />
                    <ItemsControl ItemsSource="{Binding Tools}" Focusable="False" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12,10" Margin="0,0,0,6" CornerRadius="8" Background="{DynamicResource Brush.SurfaceAlt}">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="Download" Margin="4,0" Command="{Binding InstallCommand}" ToolTip="Download a checksum-verified copy for OrbitConvert"
                                                    Visibility="{Binding CanDownload, Converter={StaticResource BoolToVisibility}}" IsEnabled="{Binding IsInstalling, Converter={StaticResource InverseBool}}" />
                                            <Button Content="Locate…" Margin="4,0" Command="{Binding BrowseCommand}" ToolTip="Choose the program file yourself" />
                                            <Button Content="&#xE712;" Style="{StaticResource IconButton}" ToolTip="More" Click="OnMoreClick">
                                                <Button.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="Open website" Command="{Binding OpenHomepageCommand}" />
                                                        <MenuItem Header="Use automatic detection" Command="{Binding ClearOverrideCommand}" IsEnabled="{Binding HasOverride}" />
                                                        <MenuItem Header="Remove downloaded copy" Command="{Binding RemoveCommand}" IsEnabled="{Binding InstalledByOrbitConvert}" />
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                            </Button>
                                        </StackPanel>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Subtitle}" FontSize="14" />
                                                <Border x:Name="Pill" CornerRadius="9" Padding="8,1" Margin="10,0,0,0" VerticalAlignment="Center" Background="{DynamicResource Brush.Success}">
                                                    <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap">
                                                <Run Text="{Binding Purpose, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding License, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding Path}" Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"
                                                       Visibility="{Binding Path, Converter={StaticResource NullToVisibility}}" />
                                            <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Accent}"
                                                       Visibility="{Binding ProgressText, Converter={StaticResource NullToVisibility}}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsFound}" Value="False">
                                        <Setter TargetName="Pill" Property="Background" Value="{DynamicResource Brush.TextTertiary}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Privacy -->
            <Border Style="{StaticResource SectionCard}">
                <StackPanel>
                    <TextBlock Text="Privacy" Style="{StaticResource Text.Subtitle}" Margin="0,0,0,6" />
                    <TextBlock Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,0,0,10"
                               Text="OrbitConvert converts everything on this computer. It has no account, no analytics and no telemetry, and never uploads your files. It only connects to the internet when you click Download for a tool or opt in to update checks." />
                    <CheckBox Content="Keep a history of conversions (stored locally)" IsChecked="{Binding KeepHistory}" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Open data folder" Command="{Binding OpenDataFolderCommand}" Margin="0,0,8,0" />
                        <Button Content="Open logs folder" Command="{Binding OpenLogsFolderCommand}" />
                    </StackPanel>
                    <TextBlock Text="{Binding DataFolder}" Style="{StaticResource Hint}" Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <!-- Updates -->
            <Border Style="{StaticResource SectionCard}">
                <StackPanel>
                    <TextBlock Text="Updates" Style="{StaticResource Text.Subtitle}" Margin="0,0,0,8" />
                    <CheckBox Content="Check GitHub for new versions (off by default)" IsChecked="{Binding CheckForUpdates}" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Check now" Command="{Binding CheckNowCommand}" />
                        <Button Content="Open release page" Margin="8,0,0,0" Command="{Binding OpenUpdateCommand}"
                                Visibility="{Binding UpdateUrl, Converter={StaticResource NullToVisibility}}" />
                    </StackPanel>
                    <TextBlock Text="{Binding UpdateStatus}" Style="{StaticResource Hint}" Margin="0,6,0,0"
                               Visibility="{Binding UpdateStatus, Converter={StaticResource NullToVisibility}}" />
                    <TextBlock Text="OrbitConvert never installs updates by itself." Style="{StaticResource Hint}" />
                </StackPanel>
            </Border>

            <!-- About -->
            <Border Style="{StaticResource SectionCard}">
                <DockPanel>
                    <Image DockPanel.Dock="Left" Source="/OrbitConvert;component/Assets/logo-256.png" Width="56" Height="56" VerticalAlignment="Top" Margin="0,0,16,0" />
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Subtitle}"><Run Text="OrbitConvert " /><Run Text="{Binding Version, Mode=OneWay}" /></TextBlock>
                        <TextBlock Text="Free and open source under the MIT license. Third-party components keep their own licenses." Style="{StaticResource Hint}" />
                        <TextBlock Text="{Binding EngineVersions}" Style="{StaticResource Hint}" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="Third-party notices" Command="{Binding OpenNoticesCommand}" Margin="0,0,8,0" />
                            <Button Content="Project on GitHub" Command="{Binding OpenProjectPageCommand}" />
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
