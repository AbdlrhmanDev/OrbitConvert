<Window x:Class="OrbitConvert.App.Views.PdfReorderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reorder PDF pages" Width="1050" Height="700" MinWidth="800" MinHeight="540"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource Brush.Window}">
    <DockPanel Margin="24">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Move up" Command="{Binding MoveUpCommand}" Style="{StaticResource OutlineButton}" Margin="0,0,8,0"/>
                <Button Content="Move down" Command="{Binding MoveDownCommand}" Style="{StaticResource OutlineButton}" Margin="0,0,8,0"/>
                <Button Content="Rotate 90°" Command="{Binding RotateCommand}" Style="{StaticResource OutlineButton}" Margin="0,0,8,0"/>
                <Button Content="Remove" Command="{Binding RemoveCommand}" Style="{StaticResource OutlineButton}"/>
            </StackPanel>
            <StackPanel><TextBlock Text="Reorder PDF" Style="{StaticResource Text.Title}"/><TextBlock Text="{Binding FileName}" Style="{StaticResource Text.Secondary}"/></StackPanel>
        </DockPanel>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Cancel" Command="{Binding CancelCommand}" Style="{StaticResource OutlineButton}" Margin="0,0,8,0"/><Button Content="Save a copy" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}"/></StackPanel>
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextSecondary}"/>
        </DockPanel>
        <ListBox ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" BorderThickness="0" Background="Transparent">
            <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
            <ListBox.ItemTemplate><DataTemplate>
                <Border Width="170" Margin="6" Padding="8" CornerRadius="12" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" Background="{DynamicResource Brush.Surface}">
                    <StackPanel><Border Height="190" Background="White"><Image Source="{Binding Thumbnail}" Stretch="Uniform"/></Border><TextBlock Text="{Binding Label}" HorizontalAlignment="Center" Margin="0,8,0,0"/><TextBlock Text="{Binding Rotation, StringFormat='Rotation {0}°'}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center"/></StackPanel>
                </Border>
            </DataTemplate></ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
