<Window x:Class="OrbitConvert.App.Views.CropEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Crop — OrbitConvert" Width="680" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True" FontFamily="{StaticResource UiFont}"
        AutomationProperties.Name="Crop editor">
    <Window.Resources>
        <Style x:Key="RatioChip" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="7" BorderThickness="1" Padding="0,8" Background="Transparent"
                                BorderBrush="{DynamicResource Brush.Track}">
                            <ContentPresenter HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.AccentText}" />
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.AccentSubtle}" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.AccentText}" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.AccentText}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Margin leaves room for the shadow of the floating panel. -->
    <Border Margin="20" CornerRadius="14" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Track}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="16" Direction="270" Opacity="0.55" Color="Black" />
        </Border.Effect>
        <DockPanel>
            <!-- Header: drag to move -->
            <Border DockPanel.Dock="Top" Height="44" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1"
                    Background="Transparent" MouseLeftButtonDown="OnHeaderMouseDown" Cursor="SizeAll">
                <DockPanel Margin="16,0,8,0">
                    <Button DockPanel.Dock="Right" Content="✕" Style="{StaticResource IconButton}" FontFamily="{StaticResource UiFont}"
                            ToolTip="Close" Command="{Binding CancelCommand}" Cursor="Hand" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ContentControl Style="{StaticResource StrokeIcon}" Width="16" Height="16" Foreground="{DynamicResource Brush.AccentText}"
                                        Tag="M6 2v16h16M2 6h16v16" />
                        <TextBlock Text="Crop" FontSize="14" FontWeight="SemiBold" Margin="10,0,10,0" Foreground="{DynamicResource Brush.Text}" />
                        <TextBlock Text="{Binding FileName}" Style="{StaticResource Text.Mono}" VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="330" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Preview with the crop frame -->
                <Border Background="{DynamicResource Brush.Window}" Padding="20" CornerRadius="0,0,0,13">
                    <Grid x:Name="PreviewHost" Width="290" Height="360">
                        <Image x:Name="PreviewImage" Source="{Binding InputPath}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                        <Canvas x:Name="CropCanvas" Background="Transparent" ClipToBounds="True">
                            <Path x:Name="Dim" Fill="#9E08090C" IsHitTestVisible="False" />
                            <Grid x:Name="CropBox" Cursor="SizeAll" Background="Transparent"
                                  MouseLeftButtonDown="OnCropMouseDown" MouseMove="OnCropMouseMove" MouseLeftButtonUp="OnCropMouseUp">
                                <Border BorderBrush="{DynamicResource Brush.Accent}" BorderThickness="1.5" />
                                <!-- Rule of thirds -->
                                <Grid IsHitTestVisible="False" Opacity="0.5">
                                    <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                    <Border Grid.Column="1" Grid.RowSpan="3" BorderBrush="{DynamicResource Brush.Accent}" BorderThickness="1,0,1,0" />
                                    <Border Grid.Row="1" Grid.ColumnSpan="3" BorderBrush="{DynamicResource Brush.Accent}" BorderThickness="0,1,0,1" />
                                </Grid>
                                <Thumb Tag="TL" Width="12" Height="12" Margin="-6" HorizontalAlignment="Left" VerticalAlignment="Top" Cursor="SizeNWSE" DragStarted="OnHandleStart" DragDelta="OnHandleDrag" Template="{DynamicResource HandleTemplate}" />
                                <Thumb Tag="TR" Width="12" Height="12" Margin="-6" HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="SizeNESW" DragStarted="OnHandleStart" DragDelta="OnHandleDrag" Template="{DynamicResource HandleTemplate}" />
                                <Thumb Tag="BL" Width="12" Height="12" Margin="-6" HorizontalAlignment="Left" VerticalAlignment="Bottom" Cursor="SizeNESW" DragStarted="OnHandleStart" DragDelta="OnHandleDrag" Template="{DynamicResource HandleTemplate}" />
                                <Thumb Tag="BR" Width="14" Height="14" Margin="-7" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE" DragStarted="OnHandleStart" DragDelta="OnHandleDrag" Template="{DynamicResource HandleTemplate}" />
                            </Grid>
                        </Canvas>
                    </Grid>
                </Border>

                <!-- Controls -->
                <StackPanel Grid.Column="1" Margin="20">
                    <TextBlock Text="Aspect ratio" Style="{StaticResource Text.Caption}" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding Ratios}" Focusable="False">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Label}" Style="{StaticResource RatioChip}" AutomationProperties.Name="{Binding Label}"
                                        Command="{Binding DataContext.PickRatioCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Width" Style="{StaticResource Text.Caption}" Margin="0,0,0,6" />
                            <TextBox Text="{Binding CropWidth, UpdateSourceTrigger=LostFocus}" FontFamily="{StaticResource MonoFont}" FontSize="13"
                                     AutomationProperties.Name="Crop width in pixels" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Height" Style="{StaticResource Text.Caption}" Margin="0,0,0,6" />
                            <TextBox Text="{Binding CropHeight, UpdateSourceTrigger=LostFocus}" FontFamily="{StaticResource MonoFont}" FontSize="13"
                                     AutomationProperties.Name="Crop height in pixels" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Margin="0,16,0,0" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" LineHeight="18"
                               Text="Drag the frame to move it. Drag a corner to resize. The original is kept." />

                    <Border Margin="0,16,0,0" Padding="12" CornerRadius="10" Background="{DynamicResource Brush.Window}"
                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                        <DockPanel>
                            <TextBlock Text="Output" Style="{StaticResource Text.Mono}" />
                            <TextBlock Text="{Binding OutputName}" Style="{StaticResource Text.Mono}" Foreground="{DynamicResource Brush.Text}"
                                       HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" Margin="12,0,0,0" />
                        </DockPanel>
                    </Border>

                    <TextBlock Text="{Binding ErrorText}" Foreground="{DynamicResource Brush.Danger}" TextWrapping="Wrap" Margin="0,12,0,0" FontSize="12"
                               Visibility="{Binding ErrorText, Converter={StaticResource NullToVisibility}}" />

                    <DockPanel Margin="0,22,0,0">
                        <Button Content="Undo" Command="{Binding UndoCommand}" Margin="0,0,8,0" Padding="12,9" />
                        <Button Content="Reset" Command="{Binding ResetCommand}" Margin="0,0,8,0" Padding="12,9" />
                        <Button Content="Apply crop" Style="{StaticResource PrimaryButton}" Command="{Binding ApplyCommand}" />
                    </DockPanel>
                </StackPanel>
            </Grid>
        </DockPanel>
    </Border>
</Window>
