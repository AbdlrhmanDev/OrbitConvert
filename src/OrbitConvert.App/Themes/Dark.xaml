<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Semantic color tokens, dark theme. Keys match Light.xaml exactly. -->
    <SolidColorBrush x:Key="Brush.Background" Color="#15161B" />
    <SolidColorBrush x:Key="Brush.Sidebar" Color="#1B1C22" />
    <SolidColorBrush x:Key="Brush.Surface" Color="#202229" />
    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="#262830" />
    <SolidColorBrush x:Key="Brush.SurfaceHover" Color="#2D2F38" />
    <SolidColorBrush x:Key="Brush.Border" Color="#30333C" />
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="#454956" />
    <SolidColorBrush x:Key="Brush.Text" Color="#F0F1F5" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#A8ADBA" />
    <SolidColorBrush x:Key="Brush.TextTertiary" Color="#7E8391" />
    <SolidColorBrush x:Key="Brush.Accent" Color="#8B80F9" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#A098FB" />
    <SolidColorBrush x:Key="Brush.AccentSubtle" Color="#2C2A4A" />
    <SolidColorBrush x:Key="Brush.OnAccent" Color="#15161B" />
    <SolidColorBrush x:Key="Brush.Success" Color="#3DCB87" />
    <SolidColorBrush x:Key="Brush.Danger" Color="#FF6B6B" />
    <SolidColorBrush x:Key="Brush.Warning" Color="#F2B232" />
    <SolidColorBrush x:Key="Brush.DropHighlight" Color="#2F2B57" />

    <SolidColorBrush x:Key="Brush.RadialDisc" Color="#E61C1D24" />
    <SolidColorBrush x:Key="Brush.RadialBorder" Color="#40FFFFFF" />
    <SolidColorBrush x:Key="Brush.RadialItem" Color="#FF2A2C35" />
    <SolidColorBrush x:Key="Brush.RadialCenter" Color="#FF262830" />

    <SolidColorBrush x:Key="Brush.Category.Image" Color="#38D39F" />
    <SolidColorBrush x:Key="Brush.Category.Video" Color="#FF8A4C" />
    <SolidColorBrush x:Key="Brush.Category.Audio" Color="#A48BFF" />
    <SolidColorBrush x:Key="Brush.Category.Document" Color="#5AA9FF" />
    <SolidColorBrush x:Key="Brush.Category.Pdf" Color="#FF6F9F" />
    <SolidColorBrush x:Key="Brush.Category.Archive" Color="#E8B53A" />
    <SolidColorBrush x:Key="Brush.Category.Other" Color="#9AA1B2" />
    <Color x:Key="Color.Shadow">#80000000</Color>
</ResourceDictionary>
