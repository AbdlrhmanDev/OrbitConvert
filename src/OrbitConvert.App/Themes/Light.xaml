<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- OrbitConvert Identity v1.0, light ("Paper"). Keys match Dark.xaml exactly.
         Deep Lime (#5B8A00) replaces Ion Lime wherever lime is text or a stroke on paper. -->
    <SolidColorBrush x:Key="Brush.Window" Color="#F4F4EF" />
    <SolidColorBrush x:Key="Brush.Background" Color="#F7F7F3" />
    <SolidColorBrush x:Key="Brush.Sidebar" Color="#ECECE5" />
    <SolidColorBrush x:Key="Brush.Surface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="#F0F0EA" />
    <SolidColorBrush x:Key="Brush.SurfaceHover" Color="#E4E4DC" />
    <SolidColorBrush x:Key="Brush.NavSelected" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.Border" Color="#DEDED6" />
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="#B9BAB0" />
    <SolidColorBrush x:Key="Brush.Track" Color="#E4E4DC" />
    <SolidColorBrush x:Key="Brush.Text" Color="#0B0C10" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#3A3F4B" />
    <SolidColorBrush x:Key="Brush.TextTertiary" Color="#5D606A" />
    <SolidColorBrush x:Key="Brush.Accent" Color="#C6F432" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#B5E21F" />
    <SolidColorBrush x:Key="Brush.AccentText" Color="#5B8A00" />
    <SolidColorBrush x:Key="Brush.AccentSubtle" Color="#F3FBD9" />
    <SolidColorBrush x:Key="Brush.OnAccent" Color="#0B0C10" />
    <SolidColorBrush x:Key="Brush.Success" Color="#5B8A00" />
    <SolidColorBrush x:Key="Brush.Danger" Color="#D93B2F" />
    <SolidColorBrush x:Key="Brush.Warning" Color="#8A6D00" />
    <SolidColorBrush x:Key="Brush.DropHighlight" Color="#F3FBD9" />

    <SolidColorBrush x:Key="Brush.AccentGradient" Color="#C6F432" />
    <RadialGradientBrush x:Key="Brush.HeroGradient" Center="0.75,0.1" GradientOrigin="0.75,0.1" RadiusX="0.9" RadiusY="1.1">
        <GradientStop Color="#F3FBD9" Offset="0" />
        <GradientStop Color="#F7F7F3" Offset="0.6" />
        <GradientStop Color="#F7F7F3" Offset="1" />
    </RadialGradientBrush>
    <SolidColorBrush x:Key="Brush.HeroGlow" Color="Transparent" />

    <!-- Orbit Menu: always the dark halo of the identity sheet, so it reads on any desktop. -->
    <SolidColorBrush x:Key="Brush.RadialDisc" Color="#E613151B" />
    <SolidColorBrush x:Key="Brush.RadialBorder" Color="#2C303B" />
    <SolidColorBrush x:Key="Brush.RadialItem" Color="#1C1F27" />
    <SolidColorBrush x:Key="Brush.RadialItemText" Color="#F2F3EE" />
    <SolidColorBrush x:Key="Brush.RadialItemHint" Color="#8A8D98" />
    <SolidColorBrush x:Key="Brush.RadialActiveHint" Color="#2E3A06" />
    <SolidColorBrush x:Key="Brush.RadialCenter" Color="#0B0C10" />
    <SolidColorBrush x:Key="Brush.RadialAccentText" Color="#C6F432" />

    <!-- File category hues: used only on format glyphs. -->
    <SolidColorBrush x:Key="Brush.Category.Image" Color="#4FD1E8" />
    <SolidColorBrush x:Key="Brush.Category.Video" Color="#FF7AC6" />
    <SolidColorBrush x:Key="Brush.Category.Audio" Color="#B68CFF" />
    <SolidColorBrush x:Key="Brush.Category.Document" Color="#6EA8FF" />
    <SolidColorBrush x:Key="Brush.Category.Pdf" Color="#FF6B5E" />
    <SolidColorBrush x:Key="Brush.Category.Archive" Color="#E8D36A" />
    <SolidColorBrush x:Key="Brush.Category.Other" Color="#8A8D98" />
    <Color x:Key="Color.Shadow">#33000000</Color>
</ResourceDictionary>
