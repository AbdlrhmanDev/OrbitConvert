<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>OrbitConvert</AssemblyName>
    <RootNamespace>OrbitConvert.App</RootNamespace>
    <ApplicationIcon>..\..\assets\icons\orbitconvert.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WPF0001: the Fluent theme API (ThemeMode) is marked experimental in .NET 9/10.
         WFO0003: WinForms is only used for the tray icon; DPI awareness is declared for WPF in app.manifest. -->
    <NoWarn>$(NoWarn);WPF0001;WFO0003</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Include="System.IO" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\OrbitConvert.Core\OrbitConvert.Core.csproj" />
    <ProjectReference Include="..\OrbitConvert.Infrastructure\OrbitConvert.Infrastructure.csproj" />
    <ProjectReference Include="..\OrbitConvert.Converters\OrbitConvert.Converters.csproj" />
    <ProjectReference Include="..\OrbitConvert.Shell\OrbitConvert.Shell.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
  </ItemGroup>
  <!-- Referenced directly only so their notice files can be located (GeneratePathProperty). -->
  <ItemGroup>
    <PackageReference Include="Magick.NET-Q8-AnyCPU" GeneratePathProperty="true" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" GeneratePathProperty="true" />
  </ItemGroup>

  <!-- License and notice files required by bundled third-party components; every build ships them in .\licenses. -->
  <PropertyGroup>
    <NoticeRuntime Condition="'$(RuntimeIdentifier)' == ''">win-x64</NoticeRuntime>
    <NoticeRuntime Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</NoticeRuntime>
    <DotNetRuntimeNotice>$(NuGetPackageRoot)microsoft.netcore.app.runtime.$(NoticeRuntime)\$(BundledNETCoreAppPackageVersion)\THIRD-PARTY-NOTICES.TXT</DotNetRuntimeNotice>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(PkgMagick_NET-Q8-AnyCPU)\Notice.txt" Link="licenses\Magick.NET-ImageMagick-and-delegate-libraries.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(PkgSkiaSharp_NativeAssets_Win32)\LICENSE.txt" Link="licenses\SkiaSharp-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(PkgSkiaSharp_NativeAssets_Win32)\THIRD-PARTY-NOTICES.txt" Link="licenses\SkiaSharp-THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\licenses\*.txt" Link="licenses\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(DotNetRuntimeNotice)" Condition="Exists('$(DotNetRuntimeNotice)')" Link="licenses\dotnet-runtime-THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\logo.png" />
    <Resource Include="Assets\logo-256.png" />
    <Resource Include="Assets\mark-128.png" />
    <Resource Include="Localization\Strings.*.xaml" />
    <!-- Bricolage Grotesque and JetBrains Mono (SIL OFL 1.1); regenerate with scripts/make-fonts.py. -->
    <Resource Include="Assets\Fonts\*.ttf" />
    <None Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\NOTICE.md" Link="NOTICE.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\LICENSE" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
