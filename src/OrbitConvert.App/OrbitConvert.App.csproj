<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>OrbitConvert</AssemblyName>
    <RootNamespace>OrbitConvert.App</RootNamespace>
    <ApplicationIcon>..\..\assets\icons\orbitconvert.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WPF0001: the Fluent theme API (ThemeMode) is marked experimental in .NET 9/10.
         WFO0003: WinForms is only used for the tray icon; DPI awareness is declared for WPF in app.manifest. -->
    <NoWarn>$(NoWarn);WPF0001;WFO0003</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Include="System.IO" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\OrbitConvert.Core\OrbitConvert.Core.csproj" />
    <ProjectReference Include="..\OrbitConvert.Infrastructure\OrbitConvert.Infrastructure.csproj" />
    <ProjectReference Include="..\OrbitConvert.Converters\OrbitConvert.Converters.csproj" />
    <ProjectReference Include="..\OrbitConvert.Shell\OrbitConvert.Shell.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\logo.png" />
    <Resource Include="Assets\logo-256.png" />
    <None Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\NOTICE.md" Link="NOTICE.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\LICENSE" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
